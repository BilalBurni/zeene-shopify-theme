{%- comment -%}
  ZEENE — About page (editorial).
  Layout Zero ke corporate page jaisa hai: bara display type, serif italic accents,
  numbers band, dark trust section, founder quote aur ek CTA card. Colors ZEENE ke
  apne hain — neon sirf fill ki tarah (kaali text ke neeche), light background par
  neon text kabhi nahi.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign stats = section.blocks | where: 'type', 'stat'
  assign chips = s.quality_chips | split: ','
-%}

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"></noscript>

{%- style -%}
#about-{{ section.id }} { background: var(--az-bg); color: var(--az-ink); padding: var(--az-pt) 0 var(--az-pb); font-family: 'Zen Maru Gothic', sans-serif; overflow-x: hidden; }
#about-{{ section.id }} * { box-sizing: border-box; }
#about-{{ section.id }} .az__wrap { max-width: var(--az-maxw); margin: 0 auto; padding: 0 var(--zeene-pad, 16px); }
#about-{{ section.id }} .az__wrap--narrow { max-width: 960px; }

{%- comment -%} Shared type — eyebrow, title, serif italic accent, neon marker. {%- endcomment -%}
#about-{{ section.id }} .az__eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(10,10,10,0.48); }
#about-{{ section.id }} .az__eyebrow::before { content: ''; width: 26px; height: 1px; background: currentColor; }
#about-{{ section.id }} .az__title { margin: 22px 0 0; font-size: clamp(32px, 4.6vw, 64px); font-weight: 800; line-height: 1.03; letter-spacing: -0.035em; }
#about-{{ section.id }} em { font-family: 'Instrument Serif', 'Zen Maru Gothic', Georgia, serif; font-style: italic; font-weight: 400; letter-spacing: -0.005em; }
#about-{{ section.id }} .az__mark { background: var(--az-accent); color: #0a0a0a; padding: 0 0.16em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
#about-{{ section.id }} .az__lead { margin: 24px 0 0; font-size: clamp(15px, 1.6vw, 18px); line-height: 1.62; color: rgba(10,10,10,0.68); max-width: 560px; }
#about-{{ section.id }} .az__intro { margin: 0; font-size: 16px; line-height: 1.6; color: rgba(10,10,10,0.62); max-width: 520px; }

{%- comment -%}
  Theme ki base.css har h1-h5 par apna color (foreground = kaala) lagati hai, is liye
  dark sections me inherit kiya hua white mar jata tha — har heading ka color yahan
  explicitly set hai. word-break bhi normal, warna bare display type beech se tootta hai.
{%- endcomment -%}
#about-{{ section.id }} h1, #about-{{ section.id }} h2, #about-{{ section.id }} h3 { word-break: normal; overflow-wrap: break-word; }
#about-{{ section.id }} .az-hero__title, #about-{{ section.id }} .az__title, #about-{{ section.id }} .az-ecard__h { color: var(--az-ink); }
#about-{{ section.id }} .az-founder__q, #about-{{ section.id }} .az-story__quote p { color: var(--az-ink); }
#about-{{ section.id }} .az-hero__poster-h, #about-{{ section.id }} .az-vision__h, #about-{{ section.id }} .az-trust .az__title, #about-{{ section.id }} .az-tcard__h, #about-{{ section.id }} .az-cta__h { color: #fff; }
#about-{{ section.id }} .az-tcard--featured .az-tcard__h { color: #0a0a0a; }

{%- comment -%} Buttons — dark pill primary, hairline ghost. {%- endcomment -%}
#about-{{ section.id }} .az__btn { display: inline-flex; align-items: center; gap: 9px; padding: 13px 24px; font-size: 12px; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase; border-radius: 9999px; text-decoration: none; transition: background-color 0.22s ease, color 0.22s ease, border-color 0.22s ease, transform 0.22s ease; }
#about-{{ section.id }} .az__btn svg { width: 14px; height: 14px; transition: transform 0.25s ease; }
#about-{{ section.id }} .az__btn:hover svg { transform: translateX(3px); }
#about-{{ section.id }} .az__btn--solid { background: var(--az-ink); color: #fff; border: 1.5px solid var(--az-ink); }
#about-{{ section.id }} .az__btn--solid:hover { background: var(--az-accent); border-color: var(--az-accent); color: #0a0a0a; transform: translateY(-1px); }
#about-{{ section.id }} .az__btn--ghost { background: transparent; color: var(--az-ink); border: 1.5px solid rgba(10,10,10,0.2); }
#about-{{ section.id }} .az__btn--ghost:hover { border-color: var(--az-ink); background: var(--az-ink); color: #fff; }
#about-{{ section.id }} .az__btn--neon { background: var(--az-accent); color: #0a0a0a; border: 1.5px solid var(--az-accent); }
#about-{{ section.id }} .az__btn--neon:hover { filter: brightness(0.94); transform: translateY(-1px); }
#about-{{ section.id }} .az__btn--onDark { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.28); }
#about-{{ section.id }} .az__btn--onDark:hover { border-color: #fff; background: #fff; color: #0a0a0a; }

{%- comment -%} 01 — Hero: copy left, poster right. {%- endcomment -%}
#about-{{ section.id }} .az-hero { position: relative; padding: 34px 0 76px; isolation: isolate; }
#about-{{ section.id }} .az-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse 70% 55% at 88% 8%, rgba(198,241,53,0.34), transparent 58%), radial-gradient(ellipse 50% 40% at 4% 82%, rgba(10,10,10,0.05), transparent 60%); pointer-events: none; }
#about-{{ section.id }} .az-hero__grid { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 60px; align-items: center; }
#about-{{ section.id }} .az-hero__title { margin: 20px 0 0; font-size: clamp(38px, 5.4vw, 76px); font-weight: 800; line-height: 0.98; letter-spacing: -0.045em; }
#about-{{ section.id }} .az-hero__stats { display: flex; flex-wrap: wrap; gap: 34px; margin-top: 34px; padding-top: 26px; border-top: 1px solid var(--az-line); }
#about-{{ section.id }} .az-hero__stat-l { font-size: 10.5px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(10,10,10,0.45); margin-bottom: 7px; }
#about-{{ section.id }} .az-hero__stat-v { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }
#about-{{ section.id }} .az-hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
#about-{{ section.id }} .az-hero__poster { position: relative; aspect-ratio: 4/5; border-radius: 26px; overflow: hidden; background: var(--az-dark); isolation: isolate; }
#about-{{ section.id }} .az-hero__poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
#about-{{ section.id }} .az-hero__poster::before { content: ''; position: absolute; inset: 0; z-index: 1; background: radial-gradient(circle at 78% 12%, rgba(198,241,53,0.34), transparent 52%), linear-gradient(180deg, rgba(10,10,10,0.15) 0%, rgba(10,10,10,0.88) 78%); }
#about-{{ section.id }} .az-hero__poster-in { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 34px; color: #fff; }
#about-{{ section.id }} .az-hero__badge { align-self: flex-start; padding: 7px 14px; border-radius: 9999px; background: var(--az-accent); color: #0a0a0a; font-size: 10px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; }
#about-{{ section.id }} .az-hero__poster-h { margin: 0; font-size: clamp(26px, 3.1vw, 42px); font-weight: 800; line-height: 1.04; letter-spacing: -0.035em; }
#about-{{ section.id }} .az-hero__poster-h em { color: var(--az-accent); }
#about-{{ section.id }} .az-hero__poster-foot { margin: 16px 0 0; font-size: 12.5px; line-height: 1.5; color: rgba(255,255,255,0.66); }
#about-{{ section.id }} .az-hero__poster-foot strong { display: block; color: var(--az-accent); font-weight: 700; margin-top: 4px; }

{%- comment -%} 02 — Numbers band. {%- endcomment -%}
#about-{{ section.id }} .az-nums { padding: 78px 0; background: var(--az-surface); border-top: 1px solid var(--az-line); border-bottom: 1px solid var(--az-line); }
#about-{{ section.id }} .az-nums__grid { display: grid; grid-template-columns: repeat({{ stats.size | at_least: 1 | at_most: 4 }}, minmax(0, 1fr)); }
#about-{{ section.id }} .az-num { padding: 6px 30px; border-left: 1px solid var(--az-line); }
#about-{{ section.id }} .az-num:first-child { border-left: 0; padding-left: 0; }
#about-{{ section.id }} .az-num__l { font-size: 10.5px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(10,10,10,0.45); margin-bottom: 16px; }
#about-{{ section.id }} .az-num__v { font-size: clamp(34px, 4.2vw, 62px); font-weight: 800; line-height: 1; letter-spacing: -0.045em; margin-bottom: 12px; }
#about-{{ section.id }} .az-num__v sup { font-size: 0.36em; vertical-align: top; position: relative; top: 0.5em; margin-left: 5px; font-weight: 800; background: var(--az-accent); color: #0a0a0a; padding: 0 6px; border-radius: 6px; letter-spacing: 0; }
#about-{{ section.id }} .az-num__s { font-size: 13.5px; line-height: 1.55; color: rgba(10,10,10,0.6); max-width: 250px; }

{%- comment -%} 03 — Story: sticky title, body, quote. {%- endcomment -%}
#about-{{ section.id }} .az-story { padding: 110px 0 100px; }
#about-{{ section.id }} .az-story__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 80px; align-items: start; }
#about-{{ section.id }} .az-story__left { position: sticky; top: 110px; }
#about-{{ section.id }} .az-story__body p { margin: 0 0 22px; font-size: clamp(16px, 1.7vw, 19px); line-height: 1.62; color: rgba(10,10,10,0.72); max-width: 640px; }
#about-{{ section.id }} .az-story__body p:last-child { margin-bottom: 0; }
#about-{{ section.id }} .az-story__body strong { color: var(--az-ink); font-weight: 700; }
#about-{{ section.id }} .az-story__quote { display: flex; gap: 22px; align-items: center; margin-top: 38px; padding: 30px 32px; background: var(--az-surface); border: 1px solid var(--az-line); border-radius: 20px; }
#about-{{ section.id }} .az-story__qmark { font-family: 'Instrument Serif', Georgia, serif; font-size: 74px; line-height: 0.62; color: var(--az-ink); flex: 0 0 auto; }
#about-{{ section.id }} .az-story__quote p { margin: 0; font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: clamp(19px, 2.2vw, 24px); line-height: 1.32; }

{%- comment -%} 04 — Vision: dark full-bleed statement. {%- endcomment -%}
#about-{{ section.id }} .az-vision { padding: 96px 0; background: var(--az-dark); color: #fff; position: relative; overflow: hidden; }
#about-{{ section.id }} .az-vision::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 88% 18%, rgba(198,241,53,0.2), transparent 52%); pointer-events: none; }
#about-{{ section.id }} .az-vision .az__wrap { position: relative; z-index: 1; }
#about-{{ section.id }} .az-vision .az__eyebrow { color: rgba(255,255,255,0.55); }
#about-{{ section.id }} .az-vision__h { margin: 24px 0 0; font-size: clamp(28px, 4vw, 56px); font-weight: 800; line-height: 1.08; letter-spacing: -0.035em; max-width: 1000px; }
#about-{{ section.id }} .az-vision__h em { color: var(--az-accent); }
#about-{{ section.id }} .az-vision__t { margin: 26px 0 0; font-size: 16px; line-height: 1.62; color: rgba(255,255,255,0.66); max-width: 640px; }

{%- comment -%} 05 — Trust: dark cards, pehla card neon. {%- endcomment -%}
#about-{{ section.id }} .az-trust { padding: 104px 0; background: var(--az-ink); color: #fff; }
#about-{{ section.id }} .az-trust .az__eyebrow { color: rgba(255,255,255,0.5); }
#about-{{ section.id }} .az-trust .az__intro { color: rgba(255,255,255,0.66); }
#about-{{ section.id }} .az-trust__head { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; align-items: end; margin-bottom: 64px; }
#about-{{ section.id }} .az-trust__cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
#about-{{ section.id }} .az-tcard { position: relative; display: flex; flex-direction: column; justify-content: space-between; min-height: 330px; padding: 28px 26px; border: 1px solid rgba(255,255,255,0.13); border-radius: 20px; background: rgba(255,255,255,0.02); transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.35s cubic-bezier(.16,1,.3,1); }
#about-{{ section.id }} .az-tcard:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.26); transform: translateY(-4px); }
#about-{{ section.id }} .az-tcard--featured { background: var(--az-accent); border-color: var(--az-accent); color: #0a0a0a; }
#about-{{ section.id }} .az-tcard--featured:hover { background: var(--az-accent); border-color: var(--az-accent); filter: brightness(0.96); }
#about-{{ section.id }} .az-tcard__num { font-size: 11px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.42); }
#about-{{ section.id }} .az-tcard--featured .az-tcard__num { color: rgba(10,10,10,0.55); }
#about-{{ section.id }} .az-tcard__ic { position: absolute; top: 24px; right: 24px; width: 38px; height: 38px; border-radius: 50%; background: rgba(255,255,255,0.08); display: inline-flex; align-items: center; justify-content: center; }
#about-{{ section.id }} .az-tcard--featured .az-tcard__ic { background: rgba(10,10,10,0.12); }
#about-{{ section.id }} .az-tcard__ic svg { width: 17px; height: 17px; }
#about-{{ section.id }} .az-tcard__h { margin: 30px 0 12px; font-size: 27px; font-weight: 800; line-height: 1.06; letter-spacing: -0.03em; }
#about-{{ section.id }} .az-tcard__b { margin: 0; font-size: 13.5px; line-height: 1.55; color: rgba(255,255,255,0.62); }
#about-{{ section.id }} .az-tcard--featured .az-tcard__b { color: rgba(10,10,10,0.72); }
#about-{{ section.id }} .az-trust__line { margin: 46px 0 0; padding-top: 34px; border-top: 1px solid rgba(255,255,255,0.12); font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: clamp(20px, 2.6vw, 32px); line-height: 1.28; color: #fff; }
#about-{{ section.id }} .az-trust__line span { color: var(--az-accent); }

{%- comment -%} 06 — Quality: equation + chips. {%- endcomment -%}
#about-{{ section.id }} .az-quality { padding: 104px 0; }
#about-{{ section.id }} .az-quality__eq { display: flex; flex-wrap: wrap; align-items: stretch; gap: 12px; margin: 46px 0 0; }
#about-{{ section.id }} .az-eq { flex: 1 1 190px; padding: 24px 22px; border: 1px solid var(--az-line); border-radius: 18px; background: var(--az-surface); }
#about-{{ section.id }} .az-eq__n { font-size: 10.5px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(10,10,10,0.42); margin-bottom: 12px; }
#about-{{ section.id }} .az-eq__v { font-size: clamp(19px, 2.1vw, 25px); font-weight: 800; line-height: 1.12; letter-spacing: -0.03em; }
#about-{{ section.id }} .az-eq--result { background: var(--az-accent); border-color: var(--az-accent); color: #0a0a0a; }
#about-{{ section.id }} .az-eq--result .az-eq__n { color: rgba(10,10,10,0.55); }
#about-{{ section.id }} .az-quality__op { align-self: center; font-size: 24px; font-weight: 800; color: rgba(10,10,10,0.3); }
#about-{{ section.id }} .az-quality__chips { display: flex; flex-wrap: wrap; gap: 9px; margin: 34px 0 0; }
#about-{{ section.id }} .az-chip { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border: 1.5px solid rgba(10,10,10,0.14); border-radius: 9999px; font-size: 11.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
#about-{{ section.id }} .az-chip::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--az-accent); }
#about-{{ section.id }} .az-quality__note { margin: 30px 0 0; font-size: 15px; line-height: 1.6; color: rgba(10,10,10,0.62); max-width: 620px; }

{%- comment -%} 07 — Experience cards. {%- endcomment -%}
#about-{{ section.id }} .az-exp { padding: 0 0 104px; }
#about-{{ section.id }} .az-exp__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 46px; }
#about-{{ section.id }} .az-ecard { padding: 32px 28px; background: var(--az-surface); border: 1px solid var(--az-line); border-radius: 20px; transition: transform 0.35s cubic-bezier(.16,1,.3,1), box-shadow 0.35s ease, border-color 0.3s ease; }
#about-{{ section.id }} .az-ecard:hover { transform: translateY(-4px); border-color: rgba(10,10,10,0.2); box-shadow: 0 24px 44px -28px rgba(10,10,10,0.35); }
#about-{{ section.id }} .az-ecard__ic { display: inline-flex; align-items: center; justify-content: center; width: 46px; height: 46px; margin-bottom: 22px; border-radius: 14px; background: var(--az-accent); color: #0a0a0a; }
#about-{{ section.id }} .az-ecard__ic svg { width: 21px; height: 21px; }
#about-{{ section.id }} .az-ecard__h { margin: 0 0 10px; font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }
#about-{{ section.id }} .az-ecard__b { margin: 0; font-size: 14px; line-height: 1.62; color: rgba(10,10,10,0.62); }

{%- comment -%} 08 — Why shop: numbered rows. {%- endcomment -%}
#about-{{ section.id }} .az-why { padding: 0 0 104px; }
#about-{{ section.id }} .az-why__list { list-style: none; margin: 42px 0 0; padding: 0; border-top: 1px solid var(--az-line); }
#about-{{ section.id }} .az-why__list li { display: grid; grid-template-columns: 54px 1.05fr 1.5fr; align-items: baseline; gap: 20px; padding: 22px 0; border-bottom: 1px solid var(--az-line); transition: background-color 0.25s ease, padding-left 0.3s cubic-bezier(.16,1,.3,1); }
#about-{{ section.id }} .az-why__list li:hover { background: var(--az-surface); padding-left: 12px; }
#about-{{ section.id }} .az-why__n { font-size: 12px; font-weight: 800; letter-spacing: 0.14em; color: rgba(10,10,10,0.35); }
#about-{{ section.id }} .az-why__t { font-size: clamp(17px, 2vw, 22px); font-weight: 800; letter-spacing: -0.025em; }
#about-{{ section.id }} .az-why__d { font-size: 14px; line-height: 1.6; color: rgba(10,10,10,0.6); }

{%- comment -%} 09 — Founder quote. {%- endcomment -%}
#about-{{ section.id }} .az-founder { padding: 96px 0 104px; background: var(--az-surface); border-top: 1px solid var(--az-line); }
#about-{{ section.id }} .az-founder__q { margin: 26px 0 0; font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: clamp(22px, 3.1vw, 40px); line-height: 1.3; letter-spacing: -0.015em; }
#about-{{ section.id }} .az-founder__q b { font-style: normal; font-family: 'Zen Maru Gothic', sans-serif; font-weight: 800; background: var(--az-accent); color: #0a0a0a; padding: 0.04em 0.14em; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
#about-{{ section.id }} .az-founder__by { display: flex; align-items: center; gap: 16px; margin-top: 38px; padding-top: 28px; border-top: 1px solid var(--az-line); }
#about-{{ section.id }} .az-founder__av { flex: 0 0 auto; width: 58px; height: 58px; border-radius: 50%; overflow: hidden; background: var(--az-ink); color: var(--az-accent); display: inline-flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; letter-spacing: 0.04em; }
#about-{{ section.id }} .az-founder__av img { width: 100%; height: 100%; object-fit: cover; }
#about-{{ section.id }} .az-founder__nm { display: block; font-size: 18px; font-weight: 800; letter-spacing: -0.02em; }
#about-{{ section.id }} .az-founder__ro { display: block; font-size: 12.5px; color: rgba(10,10,10,0.55); margin-top: 3px; }

{%- comment -%} 10 — CTA card + promise strip. {%- endcomment -%}
#about-{{ section.id }} .az-cta { padding: 96px 0 40px; }
#about-{{ section.id }} .az-cta__card { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 56px; align-items: center; padding: 62px 56px; border-radius: 28px; background: var(--az-dark); color: #fff; position: relative; overflow: hidden; }
#about-{{ section.id }} .az-cta__card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 92% 8%, rgba(198,241,53,0.22), transparent 55%); pointer-events: none; }
#about-{{ section.id }} .az-cta__card > * { position: relative; z-index: 1; }
#about-{{ section.id }} .az-cta .az__eyebrow { color: rgba(255,255,255,0.55); }
#about-{{ section.id }} .az-cta__h { margin: 22px 0 0; font-size: clamp(28px, 3.6vw, 50px); font-weight: 800; line-height: 1.04; letter-spacing: -0.035em; }
#about-{{ section.id }} .az-cta__h em { color: var(--az-accent); }
#about-{{ section.id }} .az-cta__t { margin: 20px 0 0; font-size: 15px; line-height: 1.62; color: rgba(255,255,255,0.66); max-width: 460px; }
#about-{{ section.id }} .az-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
#about-{{ section.id }} .az-cta__strip { margin: 26px 0 0; padding: 26px var(--zeene-pad, 16px); text-align: center; background: var(--az-accent); border-radius: 20px; }
#about-{{ section.id }} .az-cta__strip span { font-size: clamp(15px, 2.2vw, 24px); font-weight: 800; letter-spacing: -0.01em; color: #0a0a0a; }

{%- comment -%} Reveal — classes JS lagata hai, is liye JS na chale to sab visible rehta hai. {%- endcomment -%}
#about-{{ section.id }} .reveal, #about-{{ section.id }} .reveal-left, #about-{{ section.id }} .reveal-right, #about-{{ section.id }} .reveal-scale { opacity: 0; transition: opacity 0.7s cubic-bezier(.16,1,.3,1), transform 0.7s cubic-bezier(.16,1,.3,1); }
#about-{{ section.id }} .reveal { transform: translateY(26px); }
#about-{{ section.id }} .reveal-left { transform: translateX(-26px); }
#about-{{ section.id }} .reveal-right { transform: translateX(26px); }
#about-{{ section.id }} .reveal-scale { transform: scale(0.965); }
#about-{{ section.id }} .is-in { opacity: 1; transform: none; }
@keyframes azHeroUp { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
#about-{{ section.id }} .az-rise { animation: azHeroUp 0.75s cubic-bezier(.16,1,.3,1) backwards; }

@media (max-width: 1100px) {
  #about-{{ section.id }} .az-hero__grid, #about-{{ section.id }} .az-story__grid, #about-{{ section.id }} .az-trust__head, #about-{{ section.id }} .az-cta__card { grid-template-columns: 1fr; gap: 44px; }
  #about-{{ section.id }} .az-story__left { position: static; }
  #about-{{ section.id }} .az-nums__grid, #about-{{ section.id }} .az-trust__cards, #about-{{ section.id }} .az-exp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  #about-{{ section.id }} .az-hero__poster { aspect-ratio: 16/10; }
  #about-{{ section.id }} .az-cta__card { padding: 46px 32px; }
}

@media (max-width: 749px) {
  #about-{{ section.id }} .az-hero { padding: 20px 0 52px; }
  #about-{{ section.id }} .az-hero__stats { gap: 22px 28px; margin-top: 28px; }
  #about-{{ section.id }} .az-hero__actions .az__btn { flex: 1 1 auto; justify-content: center; }
  #about-{{ section.id }} .az-hero__poster { aspect-ratio: 4/5; border-radius: 20px; }
  #about-{{ section.id }} .az-hero__poster-in { padding: 24px; }
  #about-{{ section.id }} .az-nums, #about-{{ section.id }} .az-vision, #about-{{ section.id }} .az-trust, #about-{{ section.id }} .az-quality, #about-{{ section.id }} .az-founder { padding: 60px 0; }
  #about-{{ section.id }} .az-story { padding: 62px 0 56px; }
  #about-{{ section.id }} .az-exp, #about-{{ section.id }} .az-why { padding: 0 0 60px; }
  #about-{{ section.id }} .az-cta { padding: 60px 0 32px; }
  #about-{{ section.id }} .az-nums__grid { grid-template-columns: 1fr 1fr; }
  #about-{{ section.id }} .az-num { padding: 20px 14px 20px 0; border-left: 0; border-top: 1px solid var(--az-line); }
  #about-{{ section.id }} .az-num:nth-child(2), #about-{{ section.id }} .az-num:nth-child(4) { padding-left: 14px; border-left: 1px solid var(--az-line); }
  #about-{{ section.id }} .az-num:nth-child(1), #about-{{ section.id }} .az-num:nth-child(2) { border-top: 0; padding-top: 0; }
  #about-{{ section.id }} .az-trust__cards, #about-{{ section.id }} .az-exp__grid { grid-template-columns: 1fr; gap: 12px; }
  #about-{{ section.id }} .az-tcard { min-height: 0; padding: 26px 22px; }
  #about-{{ section.id }} .az-tcard__h { margin-top: 26px; font-size: 23px; }
  #about-{{ section.id }} .az-story__quote { flex-direction: column; align-items: flex-start; gap: 6px; padding: 24px; }
  #about-{{ section.id }} .az-quality__op { display: none; }
  #about-{{ section.id }} .az-eq { flex: 1 1 100%; }
  #about-{{ section.id }} .az-why__list li { grid-template-columns: 34px 1fr; gap: 6px 14px; padding: 18px 0; }
  #about-{{ section.id }} .az-why__d { grid-column: 2; }
  #about-{{ section.id }} .az-why__list li:hover { padding-left: 0; background: none; }
  #about-{{ section.id }} .az-cta__card { padding: 36px 24px; border-radius: 22px; gap: 32px; }
  #about-{{ section.id }} .az-cta__strip { padding: 22px 16px; }
}

@media (prefers-reduced-motion: reduce) {
  #about-{{ section.id }} .reveal, #about-{{ section.id }} .reveal-left, #about-{{ section.id }} .reveal-right, #about-{{ section.id }} .reveal-scale { opacity: 1; transform: none; transition: none; }
  #about-{{ section.id }} .az-rise { animation: none; }
  #about-{{ section.id }} .az-tcard, #about-{{ section.id }} .az-ecard, #about-{{ section.id }} .az-why__list li, #about-{{ section.id }} .az__btn { transition: none; }
}
{%- endstyle -%}

<div
  id="about-{{ section.id }}"
  class="az"
  data-az-root
  style="--az-bg:{{ s.bg_color }};--az-surface:{{ s.surface_color }};--az-ink:{{ s.text_color }};--az-accent:{{ s.accent_color }};--az-dark:{{ s.dark_color }};--az-line:{{ s.text_color | color_modify: 'alpha', 0.1 }};--az-maxw:{{ s.max_width }}px;--az-pt:{{ s.padding_top }}px;--az-pb:{{ s.padding_bottom }}px;"
>
  {%- comment -%} 01 — Hero {%- endcomment -%}
  <section class="az-hero">
    <div class="az__wrap az-hero__grid">
      <div class="az-hero__copy">
        {%- if s.hero_eyebrow != blank -%}
          <span class="az__eyebrow az-rise" style="animation-delay: 0.05s;">{{ s.hero_eyebrow }}</span>
        {%- endif -%}
        {%- if s.hero_heading != blank -%}
          <h1 class="az-hero__title az-rise" style="animation-delay: 0.12s;">{{ s.hero_heading }}</h1>
        {%- endif -%}
        {%- if s.hero_lead != blank -%}
          <p class="az__lead az-rise" style="animation-delay: 0.2s;">{{ s.hero_lead }}</p>
        {%- endif -%}

        <div class="az-hero__stats az-rise" style="animation-delay: 0.28s;">
          <div>
            <div class="az-hero__stat-l">Founded</div>
            <div class="az-hero__stat-v">{{ s.hero_stat_1 | default: '2025' }}</div>
          </div>
          <div>
            <div class="az-hero__stat-l">Collections</div>
            <div class="az-hero__stat-v">{{ s.hero_stat_2 | default: 'Men &amp; Women' }}</div>
          </div>
          <div>
            <div class="az-hero__stat-l">Delivery</div>
            <div class="az-hero__stat-v">{{ s.hero_stat_3 | default: 'Express' }}</div>
          </div>
          <div>
            <div class="az-hero__stat-l">Returns</div>
            <div class="az-hero__stat-v">{{ s.hero_stat_4 | default: '14 days' }}</div>
          </div>
        </div>

        {%- if s.hero_cta_label != blank or s.hero_cta2_label != blank -%}
          <div class="az-hero__actions az-rise" style="animation-delay: 0.36s;">
            {%- if s.hero_cta_label != blank -%}
              <a class="az__btn az__btn--solid" href="{{ s.hero_cta_link | default: routes.all_products_collection_url }}">
                {{ s.hero_cta_label }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            {%- endif -%}
            {%- if s.hero_cta2_label != blank -%}
              <a class="az__btn az__btn--ghost" href="{{ s.hero_cta2_link | default: '/pages/contact' }}">{{ s.hero_cta2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <aside class="az-hero__poster az-rise" style="animation-delay: 0.18s;">
        {%- if s.hero_image != blank -%}
          <img
            src="{{ s.hero_image | image_url: width: 1200 }}"
            srcset="{{ s.hero_image | image_url: width: 600 }} 600w, {{ s.hero_image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 1100px) 45vw, 100vw"
            alt="{{ s.hero_image.alt | default: 'ZEENE Lifestyle' | escape }}"
            width="{{ s.hero_image.width }}"
            height="{{ s.hero_image.height }}"
            loading="eager"
            decoding="async"
          >
        {%- endif -%}
        <div class="az-hero__poster-in">
          {%- if s.poster_badge != blank -%}<span class="az-hero__badge">{{ s.poster_badge }}</span>{%- endif -%}
          <div>
            {%- if s.poster_heading != blank -%}<h2 class="az-hero__poster-h">{{ s.poster_heading }}</h2>{%- endif -%}
            {%- if s.poster_foot != blank -%}
              <p class="az-hero__poster-foot">{{ s.poster_foot }}<strong>{{ s.poster_foot_strong | default: '= True Value' }}</strong></p>
            {%- endif -%}
          </div>
        </div>
      </aside>
    </div>
  </section>

  {%- comment -%} 02 — Numbers {%- endcomment -%}
  {%- if stats.size > 0 -%}
    <section class="az-nums">
      <div class="az__wrap">
        <div class="az-nums__grid">
          {%- for block in stats -%}
            <div class="az-num" {{ block.shopify_attributes }}>
              <div class="az-num__l">{{ block.settings.label }}</div>
              <div class="az-num__v">
                {{- block.settings.value -}}
                {%- if block.settings.suffix != blank -%}<sup>{{ block.settings.suffix }}</sup>{%- endif -%}
              </div>
              <div class="az-num__s">{{ block.settings.text }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 03 — Our story {%- endcomment -%}
  <section class="az-story">
    <div class="az__wrap az-story__grid">
      <div class="az-story__left">
        {%- if s.story_eyebrow != blank -%}<span class="az__eyebrow">{{ s.story_eyebrow }}</span>{%- endif -%}
        {%- if s.story_title != blank -%}<h2 class="az__title">{{ s.story_title }}</h2>{%- endif -%}
      </div>
      <div class="az-story__body rte">
        {{ s.story_body }}
        {%- if s.story_quote != blank -%}
          <div class="az-story__quote">
            <span class="az-story__qmark" aria-hidden="true">&ldquo;</span>
            <p>{{ s.story_quote }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} 04 — Vision {%- endcomment -%}
  <section class="az-vision">
    <div class="az__wrap">
      {%- if s.vision_eyebrow != blank -%}<span class="az__eyebrow">{{ s.vision_eyebrow }}</span>{%- endif -%}
      {%- if s.vision_title != blank -%}<h2 class="az-vision__h">{{ s.vision_title }}</h2>{%- endif -%}
      {%- if s.vision_text != blank -%}<p class="az-vision__t">{{ s.vision_text }}</p>{%- endif -%}
    </div>
  </section>

  {%- comment -%} 05 — Customer trust {%- endcomment -%}
  <section class="az-trust">
    <div class="az__wrap">
      <div class="az-trust__head">
        <div>
          {%- if s.trust_eyebrow != blank -%}<span class="az__eyebrow">{{ s.trust_eyebrow }}</span>{%- endif -%}
          {%- if s.trust_title != blank -%}<h2 class="az__title">{{ s.trust_title }}</h2>{%- endif -%}
        </div>
        {%- if s.trust_intro != blank -%}<p class="az__intro">{{ s.trust_intro }}</p>{%- endif -%}
      </div>

      <div class="az-trust__cards">
        <article class="az-tcard az-tcard--featured">
          <div>
            <div class="az-tcard__num">01 / Transparency</div>
            <span class="az-tcard__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg></span>
          </div>
          <div>
            <h3 class="az-tcard__h">Honest about<br>our <em>products</em></h3>
            <p class="az-tcard__b">Fabric, fit and finish described the way they really are. What you see is what arrives at your door.</p>
          </div>
        </article>

        <article class="az-tcard">
          <div>
            <div class="az-tcard__num">02 / Pricing</div>
            <span class="az-tcard__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4 12 22l-9-9V4h9l8.6 8.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.4"/></svg></span>
          </div>
          <div>
            <h3 class="az-tcard__h">Fair prices,<br><em>always</em></h3>
            <p class="az-tcard__b">Premium fashion without unnecessary markups, with pricing designed to make every purchase worthwhile.</p>
          </div>
        </article>

        <article class="az-tcard">
          <div>
            <div class="az-tcard__num">03 / Delivery</div>
            <span class="az-tcard__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h12v11H1z"/><path d="M13 8h5l4 4v3h-9z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span>
          </div>
          <div>
            <h3 class="az-tcard__h">We deliver<br>what we <em>promise</em></h3>
            <p class="az-tcard__b">Quick, tracked and reliable, from the moment an order is placed to the ZEENE package at your doorstep.</p>
          </div>
        </article>

        <article class="az-tcard">
          <div>
            <div class="az-tcard__num">04 / After-sale</div>
            <span class="az-tcard__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
          </div>
          <div>
            <h3 class="az-tcard__h">We stand behind<br>every <em>order</em></h3>
            <p class="az-tcard__b">Complete peace of mind before and after the purchase, backed by a 14-day refund &amp; exchange policy.</p>
          </div>
        </article>
      </div>

      {%- if s.trust_line != blank -%}
        <p class="az-trust__line">{{ s.trust_line }}</p>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} 06 — Commitment to quality {%- endcomment -%}
  <section class="az-quality">
    <div class="az__wrap">
      {%- if s.quality_eyebrow != blank -%}<span class="az__eyebrow">{{ s.quality_eyebrow }}</span>{%- endif -%}
      {%- if s.quality_title != blank -%}<h2 class="az__title">{{ s.quality_title }}</h2>{%- endif -%}

      <div class="az-quality__eq">
        <div class="az-eq">
          <div class="az-eq__n">01</div>
          <div class="az-eq__v">Premium<br>Quality</div>
        </div>
        <span class="az-quality__op" aria-hidden="true">+</span>
        <div class="az-eq">
          <div class="az-eq__n">02</div>
          <div class="az-eq__v">Affordable<br>Price</div>
        </div>
        <span class="az-quality__op" aria-hidden="true">+</span>
        <div class="az-eq">
          <div class="az-eq__n">03</div>
          <div class="az-eq__v">Customer<br>Trust</div>
        </div>
        <span class="az-quality__op" aria-hidden="true">=</span>
        <div class="az-eq az-eq--result">
          <div class="az-eq__n">Result</div>
          <div class="az-eq__v">True<br>Value</div>
        </div>
      </div>

      {%- if chips.size > 0 -%}
        <div class="az-quality__chips">
          {%- for chip in chips -%}
            {%- assign chip_t = chip | strip -%}
            {%- if chip_t != blank -%}<span class="az-chip">{{ chip_t }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.quality_note != blank -%}<p class="az-quality__note">{{ s.quality_note }}</p>{%- endif -%}
    </div>
  </section>

  {%- comment -%} 07 — Experience: delivery, prepaid, returns {%- endcomment -%}
  <section class="az-exp">
    <div class="az__wrap">
      {%- if s.exp_eyebrow != blank -%}<span class="az__eyebrow">{{ s.exp_eyebrow }}</span>{%- endif -%}
      {%- if s.exp_title != blank -%}<h2 class="az__title">{{ s.exp_title }}</h2>{%- endif -%}

      <div class="az-exp__grid">
        <article class="az-ecard">
          <span class="az-ecard__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 4h12v11H1z"/><path d="M13 8h5l4 4v3h-9z"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span>
          <h3 class="az-ecard__h">Express delivery</h3>
          <p class="az-ecard__b">When you order something you love, you shouldn&rsquo;t have to wait. We process and dispatch quickly, and keep the journey to your doorstep smooth and reliable.</p>
        </article>

        <article class="az-ecard">
          <span class="az-ecard__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12v9H4v-9"/><path d="M2 7h20v5H2z"/><path d="M12 21V7"/><path d="M12 7H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7z"/></svg></span>
          <h3 class="az-ecard__h">Prepaid orders &amp; giveaways</h3>
          <p class="az-ecard__b">Prepaid shopping is secure and convenient, and customers who pay in advance may get access to special giveaways, rewards, promotions and exclusive offers.</p>
        </article>

        <article class="az-ecard">
          <span class="az-ecard__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg></span>
          <h3 class="az-ecard__h">14-day refund &amp; exchange</h3>
          <p class="az-ecard__b">A no-questions-asked policy so online shopping feels safe. If a purchase isn&rsquo;t right for you, the refund or exchange stays simple, subject to our policy terms.</p>
        </article>
      </div>
    </div>
  </section>

  {%- comment -%} 08 — Why shop with ZEENE {%- endcomment -%}
  <section class="az-why">
    <div class="az__wrap">
      {%- if s.why_eyebrow != blank -%}<span class="az__eyebrow">{{ s.why_eyebrow }}</span>{%- endif -%}
      {%- if s.why_title != blank -%}<h2 class="az__title">{{ s.why_title }}</h2>{%- endif -%}

      <ul class="az-why__list">
        <li><span class="az-why__n">01</span><span class="az-why__t">Customer trust first</span><span class="az-why__d">The trust of our customers is the real profit of ZEENE Lifestyle.</span></li>
        <li><span class="az-why__n">02</span><span class="az-why__t">Premium quality</span><span class="az-why__d">Clothing designed for comfort, style and durability.</span></li>
        <li><span class="az-why__n">03</span><span class="az-why__t">Affordable prices</span><span class="az-why__d">Premium fashion without unnecessary markups.</span></li>
        <li><span class="az-why__n">04</span><span class="az-why__t">Men &amp; women collections</span><span class="az-why__d">A growing range of activewear and lifestyle fashion.</span></li>
        <li><span class="az-why__n">05</span><span class="az-why__t">Express delivery</span><span class="az-why__d">Fast and reliable delivery to your doorstep.</span></li>
        <li><span class="az-why__n">06</span><span class="az-why__t">Prepaid order benefits</span><span class="az-why__d">Opportunities for giveaways, rewards and exclusive offers.</span></li>
        <li><span class="az-why__n">07</span><span class="az-why__t">14-day refund &amp; exchange</span><span class="az-why__d">Shop with greater confidence and flexibility.</span></li>
        <li><span class="az-why__n">08</span><span class="az-why__t">True value for money</span><span class="az-why__d">Quality and pricing designed to make every purchase worthwhile.</span></li>
      </ul>
    </div>
  </section>

  {%- comment -%} 09 — Founder message {%- endcomment -%}
  <section class="az-founder">
    <div class="az__wrap az__wrap--narrow">
      {%- if s.founder_eyebrow != blank -%}<span class="az__eyebrow">{{ s.founder_eyebrow }}</span>{%- endif -%}
      {%- if s.founder_quote != blank -%}<p class="az-founder__q">{{ s.founder_quote }}</p>{%- endif -%}
      <div class="az-founder__by">
        <span class="az-founder__av">
          {%- if s.founder_image != blank -%}
            <img src="{{ s.founder_image | image_url: width: 160 }}" alt="{{ s.founder_name | escape }}" width="58" height="58" loading="lazy" decoding="async">
          {%- else -%}
            {{ s.founder_initials | default: 'TN' }}
          {%- endif -%}
        </span>
        <span>
          <span class="az-founder__nm">{{ s.founder_name | default: 'Tayyab Nadeem' }}</span>
          <span class="az-founder__ro">{{ s.founder_role | default: 'Founder &amp; CEO · ZEENE Lifestyle' }}</span>
        </span>
      </div>
    </div>
  </section>

  {%- comment -%} 10 — CTA {%- endcomment -%}
  <section class="az-cta">
    <div class="az__wrap">
      <div class="az-cta__card">
        <div>
          {%- if s.cta_eyebrow != blank -%}<span class="az__eyebrow">{{ s.cta_eyebrow }}</span>{%- endif -%}
          {%- if s.cta_heading != blank -%}<h2 class="az-cta__h">{{ s.cta_heading }}</h2>{%- endif -%}
          {%- if s.cta_text != blank -%}<p class="az-cta__t">{{ s.cta_text }}</p>{%- endif -%}
        </div>
        <div class="az-cta__actions">
          {%- if s.cta1_label != blank -%}
            <a class="az__btn az__btn--neon" href="{{ s.cta1_link | default: routes.all_products_collection_url }}">
              {{ s.cta1_label }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          {%- endif -%}
          {%- if s.cta2_label != blank -%}
            <a class="az__btn az__btn--onDark" href="{{ s.cta2_link | default: '/pages/contact' }}">{{ s.cta2_label }}</a>
          {%- endif -%}
        </div>
      </div>

      {%- if s.cta_strip != blank -%}
        <p class="az-cta__strip"><span>{{ s.cta_strip }}</span></p>
      {%- endif -%}
    </div>
  </section>
</div>

<script>
(function () {
  var root = document.getElementById('about-{{ section.id }}');
  if (!root) return;

  // Reveal classes JS se lagti hain: JS na chale to page normal dikhta hai, blank nahi.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (!e.isIntersecting) return;
      e.target.classList.add('is-in');
      io.unobserve(e.target);
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

  var LEFT = '.az-story__left, .az-trust__head > div:first-child, .az-cta__card > div:first-child';
  var RIGHT = '.az__intro, .az-cta__actions';
  var SCALE = '.az-story__quote, .az-cta__card, .az-cta__strip';

  var groups = [
    ['.az-num', 0.1],
    ['.az-story__left', 0],
    ['.az-story__body > p', 0.1],
    ['.az-story__quote', 0],
    ['.az-vision__h', 0],
    ['.az-vision__t', 0],
    ['.az-trust__head > div:first-child', 0],
    ['.az-trust .az__intro', 0],
    ['.az-tcard', 0.1],
    ['.az-trust__line', 0],
    ['.az-eq', 0.08],
    ['.az-chip', 0.03],
    ['.az-quality__note', 0],
    ['.az-ecard', 0.1],
    ['.az-why__list li', 0.06],
    ['.az-founder__q', 0],
    ['.az-founder__by', 0.1],
    ['.az-cta__card', 0],
    ['.az-cta__strip', 0]
  ];

  groups.forEach(function (g) {
    root.querySelectorAll(g[0]).forEach(function (el, i) {
      if (el.classList.contains('reveal') || el.classList.contains('reveal-left') || el.classList.contains('reveal-right') || el.classList.contains('reveal-scale')) return;
      if (el.matches(LEFT)) el.classList.add('reveal-left');
      else if (el.matches(RIGHT)) el.classList.add('reveal-right');
      else if (el.matches(SCALE)) el.classList.add('reveal-scale');
      else el.classList.add('reveal');
      if (g[1]) el.style.transitionDelay = (i * g[1]) + 's';
      io.observe(el);
    });
  });
})();
</script>

