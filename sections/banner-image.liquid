{%- liquid
  assign img = section.settings.image
  assign mimg = section.settings.mobile_image
  assign radius = section.settings.corner_radius
  assign full = section.settings.full_width
-%}

{%- style -%}
#banner-{{ section.id }} { background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
#banner-{{ section.id }} .bn__inner { {% unless full %}max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 16px;{% endunless %} }
#banner-{{ section.id }} .bn__media { display: block; position: relative; overflow: hidden; border-radius: {% if full %}0{% else %}{{ radius }}px{% endif %}; background: #f0f0f0; text-decoration: none; height: {{ section.settings.height }}px; }
#banner-{{ section.id }} .bn__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(.22,.61,.36,1); }
#banner-{{ section.id }} .bn__media--link:hover img { transform: scale(1.015); }
#banner-{{ section.id }} .bn__mob { display: none; }
#banner-{{ section.id }} .bn__ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
#banner-{{ section.id }} .bn__ph svg { width: 16%; height: 16%; opacity: 0.4; fill: #b8b8b8; }
{%- if mimg != blank -%}
@media (max-width: 749px) { #banner-{{ section.id }} .bn__desk { display: none; } #banner-{{ section.id }} .bn__mob { display: block; } }
{%- endif -%}
@media (max-width: 749px) { #banner-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px; } #banner-{{ section.id }} .bn__media { height: {{ section.settings.mobile_height }}px; } {% unless full %}#banner-{{ section.id }} .bn__inner { padding: 0 12px; }{% endunless %} }
@media (prefers-reduced-motion: reduce) { #banner-{{ section.id }} .bn__media img { transition: none; } #banner-{{ section.id }} .bn__media--link:hover img { transform: none; } }
{%- endstyle -%}

<div id="banner-{{ section.id }}" class="bn">
  <div class="bn__inner">
    {%- capture banner_inner -%}
      {%- if img != blank -%}
        <img class="bn__desk" src="{{ img | image_url: width: 2000 }}" srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 2000 }} 2000w" sizes="{% if full %}100vw{% else %}(max-width: {{ section.settings.max_width }}px) 100vw, {{ section.settings.max_width }}px{% endif %}" alt="{{ img.alt | default: 'Banner' | escape }}" width="{{ img.width }}" height="{{ img.height }}" loading="lazy" decoding="async">
      {%- endif -%}
      {%- if mimg != blank -%}
        <img class="bn__mob" src="{{ mimg | image_url: width: 1000 }}" srcset="{{ mimg | image_url: width: 600 }} 600w, {{ mimg | image_url: width: 1000 }} 1000w" sizes="100vw" alt="{{ mimg.alt | default: 'Banner' | escape }}" width="{{ mimg.width }}" height="{{ mimg.height }}" loading="lazy" decoding="async">
      {%- endif -%}
      {%- if img == blank and mimg == blank -%}
        <span class="bn__ph">{{ 'image' | placeholder_svg_tag }}</span>
      {%- endif -%}
    {%- endcapture -%}
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="bn__media bn__media--link" aria-label="{{ section.settings.link_label | default: 'Shop now' | escape }}">{{ banner_inner }}</a>
    {%- else -%}
      <div class="bn__media">{{ banner_inner }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Banner",
  "tag": "section",
  "class": "section-banner",
  "settings": [
    { "type": "header", "content": "Banner image" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)", "info": "Design your banner (with text/CTA baked in) and upload here. Wide image recommended." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)", "info": "Shown on phones. Falls back to the desktop image." },
    { "type": "url", "id": "link", "label": "Link (whole banner clickable)" },
    { "type": "text", "id": "link_label", "label": "Accessibility label", "default": "Shop now" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "full_width", "label": "Full width (edge to edge)", "default": true },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Corner radius (when not full width)", "default": 18 },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max width (when not full width)", "default": 1280 },
    { "type": "range", "id": "height", "min": 100, "max": 500, "step": 10, "unit": "px", "label": "Banner height", "default": 200 },
    { "type": "range", "id": "mobile_height", "min": 80, "max": 400, "step": 10, "unit": "px", "label": "Mobile height", "default": 160 },
    { "type": "header", "content": "Colors & spacing" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 16 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 16 }
  ],
  "presets": [
    { "name": "Banner" }
  ]
}
{% endschema %}
