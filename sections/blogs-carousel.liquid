{%- liquid
  assign blog = blogs[section.settings.blog]
  assign cols = section.settings.columns_desktop
  assign radius = section.settings.corner_radius
  assign limit = section.settings.posts_to_show
-%}

{%- style -%}
#blogs-{{ section.id }} { background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
#blogs-{{ section.id }} .bl__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 16px; }
#blogs-{{ section.id }} .bl__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
#blogs-{{ section.id }} .bl__heading { margin: 0; font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(20px, 2.6vw, 26px); font-weight: 700; line-height: 1.3; }
#blogs-{{ section.id }} .bl__sub { margin: 8px 0 0; font-size: 14px; line-height: 1.5; opacity: 0.65; }
#blogs-{{ section.id }} .bl__viewall { flex-shrink: 0; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: {{ section.settings.text_color }}; text-decoration: none; padding-bottom: 4px; border-bottom: 2px solid {{ section.settings.accent_color }}; transition: gap 0.25s ease, opacity 0.25s ease; }
#blogs-{{ section.id }} .bl__viewall:hover { gap: 13px; opacity: 0.85; }
#blogs-{{ section.id }} .bl__track { display: grid; grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); gap: 22px; }
#blogs-{{ section.id }} .bl-card { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
#blogs-{{ section.id }} .bl-card__media { position: relative; border-radius: {{ radius }}px; overflow: hidden; aspect-ratio: 3/2; background: #f0f0f0; }
#blogs-{{ section.id }} .bl-card__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(.22,.61,.36,1); }
#blogs-{{ section.id }} .bl-card:hover .bl-card__media img { transform: scale(1.05); }
#blogs-{{ section.id }} .bl-card__tag { position: absolute; top: 12px; left: 12px; z-index: 2; display: inline-flex; padding: 5px 11px; font-size: 11px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #0a0a0a; background: {{ section.settings.accent_color }}; border-radius: 9999px; }
#blogs-{{ section.id }} .bl-card__body { padding: 14px 2px 0; display: flex; flex-direction: column; gap: 8px; }
#blogs-{{ section.id }} .bl-card__date { font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; opacity: 0.5; }
#blogs-{{ section.id }} .bl-card__title { margin: 0; font-size: 18px; font-weight: 700; line-height: 1.25; letter-spacing: -0.01em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
#blogs-{{ section.id }} .bl-card:hover .bl-card__title { text-decoration: underline; text-underline-offset: 3px; }
#blogs-{{ section.id }} .bl-card__excerpt { margin: 0; font-size: 14px; line-height: 1.55; opacity: 0.7; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
#blogs-{{ section.id }} .bl-card__more { margin-top: 2px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: {{ section.settings.text_color }}; }
#blogs-{{ section.id }} .bl-card__more svg { width: 14px; height: 14px; transition: transform 0.25s ease; }
#blogs-{{ section.id }} .bl-card:hover .bl-card__more svg { transform: translateX(3px); }
#blogs-{{ section.id }} .bl-card__ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: #f4f4f4; }
#blogs-{{ section.id }} .bl-card__ph svg { width: 30%; height: 30%; opacity: 0.4; fill: #b8b8b8; }
#blogs-{{ section.id }} .bl__empty { text-align: center; padding: 30px; opacity: 0.6; }
@media (max-width: 989px) { #blogs-{{ section.id }} .bl__track { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } }
@media (max-width: 749px) {
  #blogs-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.5 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round }}px; }
  #blogs-{{ section.id }} .bl__head { margin-bottom: 16px; }
  #blogs-{{ section.id }} .bl__heading { font-size: 24px; }
  #blogs-{{ section.id }} .bl__track { display: flex; grid-template-columns: none; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 0 0 4px; }
  #blogs-{{ section.id }} .bl__track::-webkit-scrollbar { display: none; }
  #blogs-{{ section.id }} .bl-card { flex: 0 0 {{ section.settings.mobile_card_width }}%; scroll-snap-align: start; }
  #blogs-{{ section.id }} .bl-card__title { font-size: 16px; }
}
@media (prefers-reduced-motion: reduce) { #blogs-{{ section.id }} .bl-card__media img, #blogs-{{ section.id }} .bl-card__more svg { transition: none !important; } #blogs-{{ section.id }} .bl-card:hover .bl-card__media img { transform: none; } }
{%- endstyle -%}

<div id="blogs-{{ section.id }}" class="bl">
  <div class="bl__inner">
    {%- if section.settings.heading != blank or section.settings.view_all_link != blank -%}
      <div class="bl__head">
        <div>
          {%- if section.settings.heading != blank -%}<h2 class="bl__heading">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="bl__sub">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
        {%- if section.settings.view_all_link != blank -%}
          <a href="{{ section.settings.view_all_link }}" class="bl__viewall">{{ section.settings.view_all_label | default: 'View all' }}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bl__track">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: limit -%}
          <a href="{{ article.url }}" class="bl-card">
            <div class="bl-card__media">
              {%- if article.image != blank -%}
                <img src="{{ article.image | image_url: width: 700 }}" srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 700 }} 700w" sizes="(max-width: 749px) 80vw, {{ 100 | divided_by: cols }}vw" alt="{{ article.image.alt | default: article.title | escape }}" width="700" height="467" loading="lazy" decoding="async">
              {%- else -%}
                <img src="{% render 'demo-image', set: 'lifestyle', index: forloop.index0, width: 700 %}" alt="{{ article.title | escape }}" width="700" height="467" loading="lazy" decoding="async">
              {%- endif -%}
              {%- if section.settings.show_tag and article.tags.size > 0 -%}<span class="bl-card__tag">{{ article.tags.first }}</span>{%- endif -%}
            </div>
            <div class="bl-card__body">
              {%- if section.settings.show_date -%}<span class="bl-card__date">{{ article.published_at | date: '%b %d, %Y' }}</span>{%- endif -%}
              <h3 class="bl-card__title">{{ article.title }}</h3>
              {%- if section.settings.show_excerpt -%}<p class="bl-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>{%- endif -%}
              <span class="bl-card__more">Read more<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- assign demo_titles = 'How to Style an Oversized Hoodie,5 Wardrobe Essentials for Him,The Fragrance Layering Guide,Denim Care: Make It Last' | split: ',' -%}
        {%- for i in (1..limit) -%}
          {%- assign di = forloop.index0 | modulo: 4 -%}
          <a href="#" class="bl-card">
            <div class="bl-card__media">
              <img src="{% render 'demo-image', set: 'lifestyle', index: forloop.index0, width: 700 %}" alt="" width="700" height="467" loading="lazy" decoding="async">
            </div>
            <div class="bl-card__body">
              {%- if section.settings.show_date -%}<span class="bl-card__date">Jun 24, 2026</span>{%- endif -%}
              <h3 class="bl-card__title">{{ demo_titles[di] }}</h3>
              {%- if section.settings.show_excerpt -%}<p class="bl-card__excerpt">A quick read on styling, care and the little details that make the difference.</p>{%- endif -%}
              <span class="bl-card__more">Read more<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blogs Carousel",
  "tag": "section",
  "class": "section-blogs-carousel",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the Journal" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "header", "content": "Posts" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 12, "step": 1, "label": "Posts to show", "default": 4 },
    { "type": "header", "content": "Card content" },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "checkbox", "id": "show_tag", "label": "Show first tag badge", "default": false },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 4, "step": 1, "label": "Desktop columns", "default": 3 },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 28, "step": 2, "unit": "px", "label": "Corner radius", "default": 14 },
    { "type": "range", "id": "mobile_card_width", "min": 60, "max": 90, "step": 5, "unit": "%", "label": "Mobile card width", "default": 80 },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max content width", "default": 1280 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Neon accent", "default": "#C6F135" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "presets": [
    { "name": "Blogs Carousel" }
  ]
}
{% endschema %}
