{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <div class="cart-recs-inner">
    <style>
      #cart-recs { padding: 14px 0 4px; border-top: 1px solid rgba(0,0,0,0.08); margin-top: 4px; }
      #cart-recs .cart-recs__title { margin: 0 0 11px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #0a0a0a; }
      #cart-recs .cart-recs__row { display: flex; align-items: stretch; gap: 14px; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; }
      #cart-recs .cart-recs__row::-webkit-scrollbar { display: none; }
      #cart-recs .cart-recs__card { flex: 0 0 232px; display: flex; gap: 11px; align-items: stretch; }
      #cart-recs .cart-recs__media { flex: 0 0 62px; width: 62px; height: 78px; border-radius: 0; overflow: hidden; background: #f4f4f4; display: block; }
      #cart-recs .cart-recs__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
      #cart-recs .cart-recs__info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 3px; }
      #cart-recs .cart-recs__name { font-size: 12px; line-height: 1.3; color: #0a0a0a; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
      #cart-recs .cart-recs__price { font-size: 12px; font-weight: 700; color: #d11a2a; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 5px; }
      #cart-recs .cart-recs__price s { font-weight: 500; opacity: 0.5; font-size: 11px; color: #0a0a0a; }
      #cart-recs .cart-recs__add { margin-top: 5px; align-self: flex-start; padding: 5px 15px; font-size: 10px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: #0a0a0a; background: transparent; border: 1px solid rgba(0,0,0,0.22); border-radius: 7px; cursor: pointer; text-decoration: none; display: inline-block; transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease; }
      #cart-recs .cart-recs__add:hover { background: #0a0a0a; color: #fff; border-color: #0a0a0a; }
    </style>
    <h3 class="cart-recs__title">You may also like</h3>
    <div class="cart-recs__row">
      {%- for product in recommendations.products -%}
        {%- assign on_sale = false -%}
        {%- if product.compare_at_price > product.price and product.available -%}{%- assign on_sale = true -%}{%- endif -%}
        <div class="cart-recs__card">
          <a href="{{ product.url }}" class="cart-recs__media" aria-label="{{ product.title | escape }}">
            {%- if product.featured_media != blank -%}
              <img src="{{ product.featured_media | image_url: width: 200 }}" alt="{{ product.title | escape }}" width="62" height="78" loading="lazy" decoding="async">
            {%- endif -%}
          </a>
          <div class="cart-recs__info">
            <a href="{{ product.url }}" class="cart-recs__name">{{ product.title }}</a>
            <div class="cart-recs__price">{{ product.price | money }}{%- if on_sale -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}</div>
            {%- if product.variants.size == 1 and product.available -%}
              <button type="button" class="cart-recs__add js-cart-rec-add" data-variant="{{ product.selected_or_first_available_variant.id }}">Add</button>
            {%- else -%}
              <a href="{{ product.url }}" class="cart-recs__add">View</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cart recommendations"
}
{% endschema %}
