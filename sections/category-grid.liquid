{%- liquid
  assign cols = section.settings.columns_desktop
  assign radius = section.settings.corner_radius
  assign ratio = section.settings.card_ratio
-%}

{%- style -%}
#category-grid-{{ section.id }} { background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
#category-grid-{{ section.id }} .cat-grid__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 16px; }
#category-grid-{{ section.id }} .cat-grid__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
#category-grid-{{ section.id }} .cat-grid__titles { min-width: 0; }
#category-grid-{{ section.id }} .cat-grid__eyebrow { display: inline-block; margin: 0 0 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: {{ section.settings.heading_color }}; opacity: 0.55; }
#category-grid-{{ section.id }} .cat-grid__heading { margin: 0; font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(20px, 2.6vw, 26px); font-weight: 700; line-height: 1.3; color: {{ section.settings.heading_color }}; }
#category-grid-{{ section.id }} .cat-grid__sub { margin: 8px 0 0; font-size: 14px; line-height: 1.5; color: {{ section.settings.heading_color }}; opacity: 0.65; }
#category-grid-{{ section.id }} .cat-grid__viewall { flex-shrink: 0; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: {{ section.settings.heading_color }}; text-decoration: none; padding-bottom: 4px; border-bottom: 2px solid {{ section.settings.accent_color }}; transition: gap 0.25s ease, opacity 0.25s ease; }
#category-grid-{{ section.id }} .cat-grid__viewall:hover { gap: 13px; opacity: 0.85; }
#category-grid-{{ section.id }} .cat-grid__track { display: grid; grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); gap: {{ section.settings.gap }}px; }
#category-grid-{{ section.id }} .cat-card { position: relative; display: block; border-radius: {{ radius }}px; overflow: hidden; aspect-ratio: {{ ratio }}; background: #f0f0f0; text-decoration: none; isolation: isolate; transform: translateZ(0); }
#category-grid-{{ section.id }} .cat-card__media { position: absolute; inset: 0; width: 100%; height: 100%; }
#category-grid-{{ section.id }} .cat-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s cubic-bezier(.22,.61,.36,1); will-change: transform; }
#category-grid-{{ section.id }} .cat-card:hover .cat-card__media img { transform: scale(1.07); }
#category-grid-{{ section.id }} .cat-card__overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgba(8,8,8,0.82) 0%, rgba(8,8,8,0.28) 42%, rgba(8,8,8,0) 70%); transition: background 0.4s ease; }
#category-grid-{{ section.id }} .cat-card:hover .cat-card__overlay { background: linear-gradient(to top, rgba(8,8,8,0.9) 0%, rgba(8,8,8,0.4) 52%, rgba(8,8,8,0.08) 85%); }
#category-grid-{{ section.id }} .cat-card__ring { position: absolute; inset: 0; z-index: 3; border-radius: {{ radius }}px; pointer-events: none; box-shadow: inset 0 0 0 0 {{ section.settings.accent_color }}; transition: box-shadow 0.35s ease; }
#category-grid-{{ section.id }} .cat-card:hover .cat-card__ring { box-shadow: inset 0 0 0 2px {{ section.settings.accent_color }}; }
#category-grid-{{ section.id }} .cat-card__body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 18px 18px 20px; display: flex; align-items: flex-end; justify-content: space-between; gap: 10px; }
#category-grid-{{ section.id }} .cat-card__text { min-width: 0; }
#category-grid-{{ section.id }} .cat-card__label { display: block; margin: 0 0 4px; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: {{ section.settings.accent_color }}; }
#category-grid-{{ section.id }} .cat-card__title { display: block; margin: 0; font-size: 19px; font-weight: 800; line-height: 1.1; letter-spacing: -0.01em; color: #fff; }
#category-grid-{{ section.id }} .cat-card__arrow { flex-shrink: 0; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border-radius: 9999px; background: {{ section.settings.accent_color }}; color: #0a0a0a; transform: translateY(8px) scale(0.85); opacity: 0; transition: transform 0.35s cubic-bezier(.22,.61,.36,1), opacity 0.3s ease; }
#category-grid-{{ section.id }} .cat-card__arrow svg { width: 17px; height: 17px; }
#category-grid-{{ section.id }} .cat-card:hover .cat-card__arrow { transform: translateY(0) scale(1); opacity: 1; }
#category-grid-{{ section.id }} .cat-card__ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: #f4f4f4; }
#category-grid-{{ section.id }} .cat-card__ph svg { width: 38%; height: 38%; opacity: 0.4; fill: #b8b8b8; }
@media (max-width: 989px) { #category-grid-{{ section.id }} .cat-grid__track { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 749px) {
  #category-grid-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.5 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round }}px; }
  #category-grid-{{ section.id }} .cat-grid__inner { padding: 0 16px; }
  #category-grid-{{ section.id }} .cat-grid__head { margin-bottom: 18px; }
  #category-grid-{{ section.id }} .cat-grid__heading { font-size: 24px; }
  {%- if section.settings.mobile_slider -%}
  #category-grid-{{ section.id }} .cat-grid__track { display: flex; grid-template-columns: none; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 0 0 4px; }
  #category-grid-{{ section.id }} .cat-grid__track::-webkit-scrollbar { display: none; }
  #category-grid-{{ section.id }} .cat-card { flex: 0 0 {{ section.settings.mobile_card_width }}%; scroll-snap-align: start; }
  {%- else -%}
  #category-grid-{{ section.id }} .cat-grid__track { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  {%- endif -%}
  #category-grid-{{ section.id }} .cat-card__title { font-size: 16px; }
  #category-grid-{{ section.id }} .cat-card__body { padding: 14px; }
  #category-grid-{{ section.id }} .cat-card__arrow { width: 34px; height: 34px; opacity: 1; transform: none; }
}
@media (prefers-reduced-motion: reduce) { #category-grid-{{ section.id }} .cat-card__media img, #category-grid-{{ section.id }} .cat-card__arrow, #category-grid-{{ section.id }} .cat-card__overlay, #category-grid-{{ section.id }} .cat-card__ring { transition: none !important; } #category-grid-{{ section.id }} .cat-card:hover .cat-card__media img { transform: none; } }
{%- endstyle -%}

<div id="category-grid-{{ section.id }}" class="cat-grid">
  <div class="cat-grid__inner">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.view_all_link != blank -%}
      <div class="cat-grid__head">
        <div class="cat-grid__titles">
          {%- if section.settings.eyebrow != blank -%}<span class="cat-grid__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="cat-grid__heading">{{ section.settings.heading }}</h2>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="cat-grid__sub">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
        {%- if section.settings.view_all_link != blank -%}
          <a href="{{ section.settings.view_all_link }}" class="cat-grid__viewall">{{ section.settings.view_all_label | default: 'View all' }}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cat-grid__track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          assign cat_title = block.settings.title | default: 'Category'
        -%}
        <a href="{{ block.settings.link | default: '#' }}" class="cat-card" {{ block.shopify_attributes }} aria-label="{{ cat_title | escape }}">
          <span class="cat-card__media">
            {%- if img != blank -%}
              <img src="{{ img | image_url: width: 700 }}" srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1000 }} 1000w" sizes="(max-width: 749px) 80vw, {{ 100 | divided_by: cols }}vw" alt="{{ img.alt | default: cat_title | escape }}" width="{{ img.width }}" height="{{ img.height }}" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{% render 'demo-image', set: 'category', index: forloop.index0, width: 700 %}" alt="{{ cat_title | escape }}" width="700" height="933" loading="lazy" decoding="async">
            {%- endif -%}
          </span>
          <span class="cat-card__overlay"></span>
          <span class="cat-card__ring"></span>
          <span class="cat-card__body">
            <span class="cat-card__text">
              {%- if block.settings.label != blank -%}<span class="cat-card__label">{{ block.settings.label }}</span>{%- endif -%}
              <span class="cat-card__title">{{ cat_title }}</span>
            </span>
            <span class="cat-card__arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </span>
        </a>
      {%- else -%}
        {%- for i in (1..5) -%}
          <span class="cat-card"><span class="cat-card__ph">{{ 'image' | placeholder_svg_tag }}</span><span class="cat-card__overlay"></span><span class="cat-card__body"><span class="cat-card__text"><span class="cat-card__title">Category {{ i }}</span></span></span></span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category Grid",
  "tag": "section",
  "class": "section-category-grid",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (small label above)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "min": 3, "max": 6, "step": 1, "label": "Desktop columns", "default": 5 },
    { "type": "select", "id": "card_ratio", "label": "Card aspect ratio", "options": [ { "value": "3/4", "label": "Portrait (3:4)" }, { "value": "4/5", "label": "Tall (4:5)" }, { "value": "1/1", "label": "Square (1:1)" }, { "value": "9/16", "label": "Story (9:16)" } ], "default": "3/4" },
    { "type": "range", "id": "gap", "min": 4, "max": 28, "step": 2, "unit": "px", "label": "Gap between cards", "default": 14 },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Corner radius", "default": 16 },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max content width", "default": 1280 },
    { "type": "header", "content": "Mobile" },
    { "type": "checkbox", "id": "mobile_slider", "label": "Swipe slider on mobile", "default": true, "info": "Off = 2-column grid." },
    { "type": "range", "id": "mobile_card_width", "min": 55, "max": 90, "step": 5, "unit": "%", "label": "Mobile card width (slider)", "default": 70 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading & text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Neon accent", "default": "#C6F135" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait image recommended (e.g. 700x933)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "text", "id": "label", "label": "Small label (optional)", "info": "e.g. New In, Bestseller" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        { "type": "category", "settings": { "title": "T-Shirts" } },
        { "type": "category", "settings": { "title": "Trousers" } },
        { "type": "category", "settings": { "title": "Hoodies" } },
        { "type": "category", "settings": { "title": "Undergarments" } },
        { "type": "category", "settings": { "title": "Perfumes" } }
      ]
    }
  ]
}
{% endschema %}
