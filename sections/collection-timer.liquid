{%- comment -%} Sale template banner + countdown. Banner height is a setting, and breadcrumbs overlay the banner so there is no empty strip under the header. {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign mf_ns = s.banner_namespace | default: 'custom'
  assign mf_key = s.banner_key | default: 'banner'
  assign mf_link_key = s.banner_link_key | default: 'banner_link'
  assign banner_mf = collection.metafields[mf_ns][mf_key]
  assign has_banner = false
  if banner_mf != blank and banner_mf.value != blank
    assign has_banner = true
    assign banner_img = banner_mf.value
  endif
  assign banner_link = collection.metafields[mf_ns][mf_link_key]

# Only render breadcrumbs here on the sale template, where theme.liquid skips its own. Prevents duplicates.
  assign owns_breadcrumb = false
  if template.name == 'collection' and template.suffix == 'sale'
    assign owns_breadcrumb = true
  endif
-%}

{%- if has_banner or s.show_timer -%}
  <div id="collection-timer-{{ section.id }}" class="ct" style="--ct-bg:{{ s.bg_color }};--ct-band:{{ s.band_color }};--ct-maxw:{{ s.max_width }}px;--ct-radius:{{ s.corner_radius }}px;--ct-card:{{ s.strip_color }};--ct-heading:{{ s.heading_color }};--ct-num:{{ s.number_color }};--ct-label:{{ s.label_color }};--ct-accent:{{ s.accent_color }};--ct-accent2:{{ s.accent_color_2 }};--ct-pt:{{ s.padding_top }}px;--ct-pb:{{ s.padding_bottom }}px;--ct-bh:{% if s.banner_height > 0 %}{{ s.banner_height }}px{% else %}auto{% endif %};--ct-bh-m:{% if s.banner_height_mobile > 0 %}{{ s.banner_height_mobile }}px{% else %}auto{% endif %};">
    {%- if has_banner -%}
      <div class="ct__banner{% if s.full_width_banner %} ct__banner--full{% else %} ct__banner--boxed{% endif %}">
        {%- if banner_link != blank -%}<a class="ct__banner-link" href="{{ banner_link }}">{%- endif -%}
        <img
          src="{{ banner_img | image_url: width: 1800 }}"
          srcset="{{ banner_img | image_url: width: 900 }} 900w, {{ banner_img | image_url: width: 1400 }} 1400w, {{ banner_img | image_url: width: 1800 }} 1800w, {{ banner_img | image_url: width: 2400 }} 2400w, {{ banner_img | image_url: width: 3000 }} 3000w"
          sizes="{% if s.full_width_banner %}100vw{% else %}(max-width: {{ s.max_width }}px) 100vw, {{ s.max_width }}px{% endif %}"
          alt="{{ collection.title | escape }}"
          width="{{ banner_img.width | default: 1800 }}"
          height="{{ banner_img.height | default: 700 }}"
          fetchpriority="high"
          decoding="async"
        >
        {%- if banner_link != blank -%}</a>{%- endif -%}
        {%- if owns_breadcrumb and s.breadcrumb_on_banner -%}
          {%- render 'breadcrumbs', from_section: true, overlay: true -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if owns_breadcrumb -%}
      {%- unless has_banner and s.breadcrumb_on_banner -%}
        {%- render 'breadcrumbs', from_section: true -%}
      {%- endunless -%}
    {%- endif -%}

    {%- if s.show_timer -%}
      <div class="ct__band">
        <div class="ct__inner">
          {%- if s.heading != blank -%}
            <div class="ct__head">
              <span class="ct__line" aria-hidden="true"></span>
              <h2 class="ct__heading">{{ s.heading }}</h2>
              <span class="ct__line ct__line--r" aria-hidden="true"></span>
            </div>
          {%- endif -%}

          <div class="ct__cards" data-reset="{{ s.end_time }}" role="timer" aria-label="Offer countdown">
            {%- if s.show_days -%}
              <div class="ct__card">
                <i class="ct__c ct__c--tl" aria-hidden="true"></i><i class="ct__c ct__c--tr" aria-hidden="true"></i><i class="ct__c ct__c--bl" aria-hidden="true"></i><i class="ct__c ct__c--br" aria-hidden="true"></i>
                <span class="ct__num" data-unit="days">00</span>
                <span class="ct__label">Days</span>
              </div>
            {%- endif -%}
            <div class="ct__card">
              <i class="ct__c ct__c--tl" aria-hidden="true"></i><i class="ct__c ct__c--tr" aria-hidden="true"></i><i class="ct__c ct__c--bl" aria-hidden="true"></i><i class="ct__c ct__c--br" aria-hidden="true"></i>
              <span class="ct__num" data-unit="hours">00</span>
              <span class="ct__label">Hours</span>
            </div>
            <div class="ct__card">
              <i class="ct__c ct__c--tl" aria-hidden="true"></i><i class="ct__c ct__c--tr" aria-hidden="true"></i><i class="ct__c ct__c--bl" aria-hidden="true"></i><i class="ct__c ct__c--br" aria-hidden="true"></i>
              <span class="ct__num" data-unit="minutes">00</span>
              <span class="ct__label">Minutes</span>
            </div>
            <div class="ct__card">
              <i class="ct__c ct__c--tl" aria-hidden="true"></i><i class="ct__c ct__c--tr" aria-hidden="true"></i><i class="ct__c ct__c--bl" aria-hidden="true"></i><i class="ct__c ct__c--br" aria-hidden="true"></i>
              <span class="ct__num" data-unit="seconds">00</span>
              <span class="ct__label">Seconds</span>
            </div>
          </div>

          {%- if s.note != blank -%}<p class="ct__note">{{ s.note }}</p>{%- endif -%}

          {%- if s.show_progress -%}
            <span class="ct__progress" aria-hidden="true"><span class="ct__progress-fill js-ct-progress"></span></span>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{%- style -%}
#collection-timer-{{ section.id }}.ct { background: var(--ct-bg); padding: var(--ct-pt) 0 var(--ct-pb); }
#collection-timer-{{ section.id }} *, #collection-timer-{{ section.id }} *::before, #collection-timer-{{ section.id }} *::after { box-sizing: border-box; }
#collection-timer-{{ section.id }} .ct__inner { max-width: var(--ct-maxw); margin: 0 auto; padding: 0 16px; }

#collection-timer-{{ section.id }} .ct__banner { position: relative; overflow: hidden; }
#collection-timer-{{ section.id }} .ct__banner--boxed { max-width: var(--ct-maxw); margin: 0 auto; border-radius: var(--ct-radius); }
#collection-timer-{{ section.id }} .ct__banner img { display: block; width: 100%; height: var(--ct-bh); object-fit: cover; object-position: center; }
#collection-timer-{{ section.id }} .ct__banner-link { display: block; }

#collection-timer-{{ section.id }} .ct__band { background: var(--ct-band); padding: clamp(18px, 2.1vw, 26px) 0 clamp(18px, 2.1vw, 26px); }

#collection-timer-{{ section.id }} .ct__head { display: flex; align-items: center; justify-content: center; gap: clamp(8px, 1.2vw, 12px); margin: 0 0 clamp(12px, 1.5vw, 16px); }
#collection-timer-{{ section.id }} .ct__line { flex: 0 1 84px; height: 1.5px; border-radius: 2px; background: linear-gradient(90deg, transparent, var(--ct-accent)); }
#collection-timer-{{ section.id }} .ct__line--r { background: linear-gradient(90deg, var(--ct-accent), transparent); }
#collection-timer-{{ section.id }} .ct__heading { margin: 0; font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(10.5px, 1.15vw, 13px); font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ct-heading); white-space: nowrap; }

#collection-timer-{{ section.id }} .ct__cards { display: flex; align-items: stretch; justify-content: center; gap: clamp(8px, 1vw, 12px); }
#collection-timer-{{ section.id }} .ct__card { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; min-width: clamp(78px, 8vw, 98px); padding: clamp(12px, 1.4vw, 15px) clamp(10px, 1.3vw, 14px) clamp(8px, 1.1vw, 10px); background: var(--ct-card); border: 1px solid {{ s.accent_color_2 | color_modify: 'alpha', 0.55 }}; border-radius: 12px; box-shadow: 0 8px 18px -14px rgba(20,16,40,0.2); }

{%- comment -%} Corner brackets: accent on top, dark on the bottom. {%- endcomment -%}
#collection-timer-{{ section.id }} .ct__c { position: absolute; width: 10px; height: 10px; pointer-events: none; }
#collection-timer-{{ section.id }} .ct__c--tl { top: 7px; left: 7px; border-top: 1.6px solid var(--ct-accent); border-left: 1.6px solid var(--ct-accent); border-top-left-radius: 4px; }
#collection-timer-{{ section.id }} .ct__c--tr { top: 7px; right: 7px; border-top: 1.6px solid var(--ct-accent); border-right: 1.6px solid var(--ct-accent); border-top-right-radius: 4px; }
#collection-timer-{{ section.id }} .ct__c--bl { bottom: 7px; left: 7px; border-bottom: 1.6px solid var(--ct-accent2); border-left: 1.6px solid var(--ct-accent2); border-bottom-left-radius: 4px; }
#collection-timer-{{ section.id }} .ct__c--br { bottom: 7px; right: 7px; border-bottom: 1.6px solid var(--ct-accent2); border-right: 1.6px solid var(--ct-accent2); border-bottom-right-radius: 4px; }

#collection-timer-{{ section.id }} .ct__num { font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(22px, 2.3vw, 30px); font-weight: 800; line-height: 1; letter-spacing: -0.02em; color: var(--ct-num); font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1; }
#collection-timer-{{ section.id }} .ct__num.is-tick { animation: cttick-{{ section.id }} 0.3s ease-out; }
@keyframes cttick-{{ section.id }} { 0% { transform: translateY(-18%); opacity: 0.3; } 60% { transform: translateY(2%); opacity: 1; } 100% { transform: none; } }
#collection-timer-{{ section.id }} .ct__label { font-size: clamp(7.5px, 0.8vw, 9px); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ct-label); }

#collection-timer-{{ section.id }} .ct__note { margin: clamp(10px, 1.3vw, 13px) 0 0; text-align: center; font-size: clamp(10.5px, 1.1vw, 12px); color: var(--ct-label); }
#collection-timer-{{ section.id }} .ct__progress { display: block; width: min(300px, 66%); height: 2px; margin: 12px auto 0; border-radius: 3px; overflow: hidden; background: {{ s.accent_color | color_modify: 'alpha', 0.22 }}; }
#collection-timer-{{ section.id }} .ct__progress-fill { display: block; height: 100%; width: 100%; background: var(--ct-accent); transition: width 0.8s linear; }

@media (max-width: 749px) {
  #collection-timer-{{ section.id }} .ct__banner img { height: var(--ct-bh-m); }
  #collection-timer-{{ section.id }} .ct__band { padding: 16px 0 16px; }
  #collection-timer-{{ section.id }} .ct__inner { padding: 0 14px; }
  #collection-timer-{{ section.id }} .ct__head { gap: 7px; margin-bottom: 11px; }
  #collection-timer-{{ section.id }} .ct__line { flex: 0 1 34px; }
  #collection-timer-{{ section.id }} .ct__heading { font-size: 10px; letter-spacing: 0.14em; }
  #collection-timer-{{ section.id }} .ct__cards { gap: 7px; }
  #collection-timer-{{ section.id }} .ct__card { min-width: 0; flex: 1 1 0; max-width: 104px; padding: 11px 6px 8px; border-radius: 11px; gap: 4px; }
  #collection-timer-{{ section.id }} .ct__c { width: 9px; height: 9px; top: 6px; left: 6px; }
  #collection-timer-{{ section.id }} .ct__c--tr { left: auto; right: 6px; }
  #collection-timer-{{ section.id }} .ct__c--bl { top: auto; bottom: 6px; }
  #collection-timer-{{ section.id }} .ct__c--br { top: auto; left: auto; bottom: 6px; right: 6px; }
  #collection-timer-{{ section.id }} .ct__num { font-size: 22px; }
  #collection-timer-{{ section.id }} .ct__label { font-size: 7.5px; letter-spacing: 0.1em; }
}
@media (prefers-reduced-motion: reduce) {
  #collection-timer-{{ section.id }} .ct__num.is-tick { animation: none; }
}
{%- endstyle -%}

<script>
(function () {
  var root = document.getElementById('collection-timer-{{ section.id }}');
  if (!root) return;
  var timer = root.querySelector('.ct__cards');
  if (!timer) return;
  var DAY_MS = 86400000;

  function parseReset(str) {
    var m = /^(\d{1,2}):(\d{2})$/.exec(String(str || '').trim());
    if (!m) return { h: 23, min: 59 };
    var h = parseInt(m[1], 10), min = parseInt(m[2], 10);
    if (h > 23 || min > 59) return { h: 23, min: 59 };
    return { h: h, min: min };
  }

  var reset = parseReset(timer.getAttribute('data-reset'));
  var progress = root.querySelector('.js-ct-progress');
  var units = [
    { els: timer.querySelectorAll('[data-unit="days"]'), get: function (d) { return Math.floor(d / DAY_MS); } },
    { els: timer.querySelectorAll('[data-unit="hours"]'), get: function (d) { return Math.floor((d / 3600000) % 24); } },
    { els: timer.querySelectorAll('[data-unit="minutes"]'), get: function (d) { return Math.floor((d / 60000) % 60); } },
    { els: timer.querySelectorAll('[data-unit="seconds"]'), get: function (d) { return Math.floor((d / 1000) % 60); } }
  ];

  function pad(n) { return String(n).padStart(2, '0'); }

  function paint(el, val) {
    if (el.textContent === val) return;
    el.textContent = val;
el.classList.remove('is-tick');
    void el.offsetWidth;
    el.classList.add('is-tick');
  }

  function getRemainingMs() {
    var now = new Date();
    var target = new Date(now.getFullYear(), now.getMonth(), now.getDate(), reset.h, reset.min, 0, 0);
    if (now >= target) target.setDate(target.getDate() + 1);
    var diff = target - now;
    return diff > 0 ? diff : DAY_MS;
  }

  function tick() {
    var diff = getRemainingMs();
    for (var u = 0; u < units.length; u++) {
      var val = pad(units[u].get(diff));
      for (var i = 0; i < units[u].els.length; i++) paint(units[u].els[i], val);
    }
    if (progress) progress.style.width = Math.max(0, Math.min(100, (diff / DAY_MS) * 100)).toFixed(2) + '%';
  }

  function start() { tick(); setInterval(tick, 1000); }
  if (document.readyState === 'complete' || document.readyState === 'interactive') start();
  else document.addEventListener('DOMContentLoaded', start, { once: true });
})();
</script>

{% schema %}
{
  "name": "Collection timer",
  "tag": "section",
  "class": "section-collection-timer",
  "settings": [
    { "type": "header", "content": "Dynamic banner (from collection metafield)" },
    { "type": "paragraph", "content": "Add a collection metafield (type Image) with namespace + key below. Only collections that have this metafield filled will show a banner — empty = nothing shown." },
    { "type": "text", "id": "banner_namespace", "label": "Metafield namespace", "default": "custom" },
    { "type": "text", "id": "banner_key", "label": "Metafield key (image)", "default": "banner" },
    { "type": "text", "id": "banner_link_key", "label": "Metafield key (link, optional URL)", "default": "banner_link" },
    { "type": "checkbox", "id": "full_width_banner", "label": "Full-width banner", "default": true },
    { "type": "range", "id": "banner_height", "min": 0, "max": 700, "step": 20, "unit": "px", "label": "Banner height — desktop", "default": 480, "info": "0 = use the image's own height. Otherwise the image is cropped from the centre." },
    { "type": "range", "id": "banner_height_mobile", "min": 0, "max": 500, "step": 10, "unit": "px", "label": "Banner height — mobile", "default": 0, "info": "0 = show the whole image, nothing cropped (recommended on mobile)." },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Banner corner radius (when not full-width)", "default": 16 },
    { "type": "checkbox", "id": "breadcrumb_on_banner", "label": "Show breadcrumbs over the banner", "default": true, "info": "Removes the empty strip between the header and the banner. Turn off to show breadcrumbs above the banner instead." },

    { "type": "header", "content": "Countdown" },
    { "type": "checkbox", "id": "show_timer", "label": "Show countdown timer", "default": true },
    { "type": "checkbox", "id": "show_days", "label": "Show days card", "default": false, "info": "Off = Hours / Minutes / Seconds only (recommended for a 24h daily offer)." },
    { "type": "text", "id": "heading", "label": "Heading above the cards", "default": "Sale might end in" },
    { "type": "text", "id": "note", "label": "Small note under the cards", "info": "Optional — leave empty to hide." },
    { "type": "text", "id": "end_time", "label": "Daily reset time (HH:MM, 24h)", "default": "23:59", "info": "Counts down to this time each day, then auto-restarts the next 24h cycle." },
    { "type": "checkbox", "id": "show_progress", "label": "Show progress line under the cards", "default": false },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "band_color", "label": "Countdown band background", "default": "#F5FBE4", "info": "The tinted strip behind the timer." },
    { "type": "color", "id": "strip_color", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "heading_color", "label": "Heading text", "default": "#0a0a0a" },
    { "type": "color", "id": "number_color", "label": "Countdown digits", "default": "#0a0a0a" },
    { "type": "color", "id": "label_color", "label": "Card labels / note", "default": "#8a8f7a" },
    { "type": "color", "id": "accent_color", "label": "Accent — heading lines + top corners", "default": "#C6F135" },
    { "type": "color", "id": "accent_color_2", "label": "Accent — bottom corners", "default": "#D5DCC4" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max content width", "default": 1280 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 0 }
  ],
  "presets": [
    { "name": "Collection timer" }
  ]
}
{% endschema %}
