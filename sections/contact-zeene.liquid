{%- liquid
  assign s = section.settings
  assign infos = section.blocks | where: 'type', 'info'
  assign wa_num = settings.wa_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
-%}

<div
  id="contact-{{ section.id }}"
  class="cz"
  style="--cz-bg:{{ s.bg_color }};--cz-text:{{ s.text_color }};--cz-accent:{{ s.accent_color }};--cz-line:{{ s.divider_color }};--cz-maxw:{{ s.max_width }}px;--cz-pt:{{ s.padding_top }}px;--cz-pb:{{ s.padding_bottom }}px;"
>
  <div class="cz__inner">
    <header class="cz__head">
      {%- if s.eyebrow != blank -%}<span class="cz__eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h1 class="cz__heading">{{ s.heading }}</h1>{%- endif -%}
      {%- if s.subheading != blank -%}<p class="cz__sub">{{ s.subheading }}</p>{%- endif -%}
    </header>

    <div class="cz__layout">
      <div class="cz__formwrap">
        <h2 class="cz__form-title">{{ s.form_heading | default: 'Send us a message' }}</h2>

        {%- form 'contact', id: 'ContactForm', class: 'cz__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="cz__note cz__note--ok" role="status" tabindex="-1" autofocus>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
              <span>{{ s.success_message | default: 'Thanks — your message is with us. Our team will get back to you shortly.' }}</span>
            </div>
          {%- elsif form.errors -%}
            <div class="cz__note cz__note--error" role="alert" tabindex="-1" autofocus>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 7v6M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
              <span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
            </div>
          {%- endif -%}

          <div class="cz__row">
            <div class="cz__field">
              <label class="cz__label" for="ContactForm-name">Name</label>
              <input class="cz__input" type="text" id="ContactForm-name" name="contact[Name]" autocomplete="name" placeholder="Your full name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
            </div>
            <div class="cz__field">
              <label class="cz__label" for="ContactForm-phone">Phone / WhatsApp</label>
              <input class="cz__input" type="tel" id="ContactForm-phone" name="contact[Phone]" autocomplete="tel" placeholder="03XX XXXXXXX" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
            </div>
          </div>

          <div class="cz__row">
            <div class="cz__field">
              <label class="cz__label" for="ContactForm-email">Email <span aria-hidden="true">*</span></label>
              <input class="cz__input{% if form.errors contains 'email' %} is-error{% endif %}" type="email" id="ContactForm-email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required aria-required="true" placeholder="you@email.com" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
            </div>
            {%- if s.show_order_field -%}
              <div class="cz__field">
                <label class="cz__label" for="ContactForm-order">Order number <span class="cz__opt">(optional)</span></label>
                <input class="cz__input" type="text" id="ContactForm-order" name="contact[Order number]" placeholder="#1234">
              </div>
            {%- endif -%}
          </div>

          {%- if s.show_topic_field -%}
            <div class="cz__field">
              <label class="cz__label" for="ContactForm-topic">What is this about?</label>
              <div class="cz__selectwrap">
                <select class="cz__input cz__select" id="ContactForm-topic" name="contact[Topic]">
                  {%- assign topics = s.topics | split: ',' -%}
                  {%- for t in topics -%}
                    <option value="{{ t | strip | escape }}">{{ t | strip }}</option>
                  {%- endfor -%}
                </select>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </div>
            </div>
          {%- endif -%}

          <div class="cz__field">
            <label class="cz__label" for="ContactForm-body">Message</label>
            {%- comment -%} name="contact[body]" hi rakhna — Shopify isay hi message body samajhta hai. {%- endcomment -%}
            <textarea class="cz__input cz__textarea" rows="6" id="ContactForm-body" name="contact[body]" placeholder="Tell us what you need help with…">{{ form.body }}</textarea>
          </div>

          <button type="submit" class="cz__submit">
            {{ s.button_label | default: 'Send message' }}
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>

          {%- if s.form_note != blank -%}<p class="cz__formnote">{{ s.form_note }}</p>{%- endif -%}
        {%- endform -%}
      </div>

      <aside class="cz__side">
        {%- if s.show_whatsapp and settings.wa_number != blank -%}
          <a class="cz__card cz__card--wa" href="https://wa.me/{{ wa_num }}{% if settings.wa_message != blank %}?text={{ settings.wa_message | url_encode }}{% endif %}" target="_blank" rel="noopener">
            <span class="cz__card-ic" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm5.43 12.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"/></svg>
            </span>
            <span class="cz__card-body">
              <span class="cz__card-title">{{ s.whatsapp_title | default: 'WhatsApp us' }}</span>
              <span class="cz__card-text">{{ s.whatsapp_text | default: 'Fastest replies — order updates, sizing and exchanges.' }}</span>
              <span class="cz__card-cta">Start a chat
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </span>
          </a>
        {%- endif -%}

        {%- for block in infos -%}
          {%- assign c = block.settings -%}
          {%- if c.link != blank -%}<a class="cz__card" href="{{ c.link }}"{% if c.new_tab %} target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>{%- else -%}<div class="cz__card cz__card--static" {{ block.shopify_attributes }}>{%- endif -%}
            <span class="cz__card-ic" aria-hidden="true">
              {%- case c.icon -%}
                {%- when 'mail' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                {%- when 'phone' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1.1 1A16 16 0 0 1 4 5.1 1 1 0 0 1 5 4z"/></svg>
                {%- when 'clock' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                {%- when 'pin' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 1 1-3.2-6.4"/><path d="M9.5 9a2.6 2.6 0 1 1 3.4 2.5c-.6.2-.9.7-.9 1.3v.5"/><path d="M12 17h.01"/></svg>
              {%- endcase -%}
            </span>
            <span class="cz__card-body">
              <span class="cz__card-title">{{ c.title }}</span>
              {%- if c.text != blank -%}<span class="cz__card-text">{{ c.text }}</span>{%- endif -%}
              {%- if c.link != blank and c.link_label != blank -%}
                <span class="cz__card-cta">{{ c.link_label }}
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              {%- endif -%}
            </span>
          {%- if c.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- endfor -%}

        {%- if s.show_social -%}
          {%- capture social_links -%}
            {%- if settings.social_instagram_link != blank -%}<a class="cz__social" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg></a>{%- endif -%}
            {%- if settings.social_facebook_link != blank -%}<a class="cz__social" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.5-1.5h1.7V3.9c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1V10H7.5v3h2.8v8h3.2z"/></svg></a>{%- endif -%}
            {%- if settings.social_tiktok_link != blank -%}<a class="cz__social" href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.3 2 1.5 3.4 3.5 3.6v2.5c-1.3.1-2.5-.3-3.6-1v5.6c0 4-3.3 6.5-6.7 5.5-2.4-.7-3.9-3-3.7-5.5.2-2.6 2.5-4.6 5.1-4.5v2.6c-.4-.1-.8-.1-1.2 0-1.2.2-2 1.3-1.8 2.5.2 1.1 1.2 1.9 2.4 1.7 1.1-.2 1.9-1.1 1.9-2.2V3h2.9z"/></svg></a>{%- endif -%}
            {%- if settings.social_youtube_link != blank -%}<a class="cz__social" href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M21.6 7.2c-.2-.9-.9-1.6-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4c-.9.2-1.6.9-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8c.2.9.9 1.6 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15.2V8.8l5.2 3.2-5.2 3.2z"/></svg></a>{%- endif -%}
          {%- endcapture -%}
          {%- if social_links != blank -%}
            <div class="cz__socialwrap">
              <span class="cz__social-label">{{ s.social_label | default: 'Follow us' }}</span>
              <div class="cz__socials">{{ social_links }}</div>
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- if s.faq_link != blank -%}
          <a class="cz__faq" href="{{ s.faq_link }}">
            <span>{{ s.faq_text | default: 'Most questions are already answered on our FAQs page.' }}</span>
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </aside>
    </div>
  </div>
</div>

{%- style -%}
#contact-{{ section.id }} { background: var(--cz-bg); color: var(--cz-text); padding: var(--cz-pt) 0 var(--cz-pb); }
#contact-{{ section.id }} .cz__inner { max-width: var(--cz-maxw); margin: 0 auto; padding: 0 16px; }

#contact-{{ section.id }} .cz__head { max-width: 720px; margin: 0 0 38px; }
#contact-{{ section.id }} .cz__eyebrow { display: inline-block; margin: 0 0 10px; font-size: 11px; font-weight: 800; letter-spacing: 0.24em; text-transform: uppercase; opacity: 0.5; }
#contact-{{ section.id }} .cz__heading { margin: 0; font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(26px, 4vw, 40px); font-weight: 500; line-height: 1.18; letter-spacing: -0.015em; }
#contact-{{ section.id }} .cz__sub { margin: 12px 0 0; font-size: 15px; line-height: 1.65; opacity: 0.62; }

#contact-{{ section.id }} .cz__layout { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 44px; align-items: start; }

#contact-{{ section.id }} .cz__formwrap { padding: 28px; border: 1px solid var(--cz-line); border-radius: 18px; background: #fff; }
#contact-{{ section.id }} .cz__form-title { margin: 0 0 20px; font-family: 'Zen Maru Gothic', sans-serif; font-size: 17px; font-weight: 700; }
#contact-{{ section.id }} .cz__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
#contact-{{ section.id }} .cz__field { display: flex; flex-direction: column; gap: 7px; margin-bottom: 14px; }
#contact-{{ section.id }} .cz__label { font-size: 11.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; }
#contact-{{ section.id }} .cz__opt { font-weight: 600; letter-spacing: 0.04em; text-transform: none; opacity: 0.7; }
#contact-{{ section.id }} .cz__input { width: 100%; height: 48px; padding: 0 14px; font-family: 'Zen Maru Gothic', sans-serif; font-size: 14.5px; color: var(--cz-text); background-color: {{ s.text_color | color_modify: 'alpha', 0.03 }}; border: 1.5px solid {{ s.text_color | color_modify: 'alpha', 0.14 }}; border-radius: 11px; outline: 0; transition: border-color 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease; }
#contact-{{ section.id }} .cz__input::placeholder { color: {{ s.text_color | color_modify: 'alpha', 0.38 }}; }
#contact-{{ section.id }} .cz__input:focus { background-color: #fff; border-color: var(--cz-text); box-shadow: 0 0 0 4px {{ s.accent_color | color_modify: 'alpha', 0.30 }}; }
#contact-{{ section.id }} .cz__input.is-error { border-color: #d11a2a; }
#contact-{{ section.id }} .cz__textarea { height: auto; min-height: 130px; padding: 14px; line-height: 1.6; resize: vertical; }
#contact-{{ section.id }} .cz__selectwrap { position: relative; }
#contact-{{ section.id }} .cz__select { appearance: none; -webkit-appearance: none; padding-right: 40px; cursor: pointer; }
#contact-{{ section.id }} .cz__selectwrap svg { position: absolute; right: 14px; top: 50%; width: 15px; height: 15px; transform: translateY(-50%); pointer-events: none; opacity: 0.55; }

#contact-{{ section.id }} .cz__submit { display: inline-flex; align-items: center; justify-content: center; gap: 9px; width: 100%; height: 52px; margin-top: 6px; font-family: 'Zen Maru Gothic', sans-serif; font-size: 12.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #0a0a0a; background: var(--cz-accent); border: 0; border-radius: 11px; cursor: pointer; transition: filter 0.18s ease, transform 0.15s ease; }
#contact-{{ section.id }} .cz__submit:hover { filter: brightness(0.94); transform: translateY(-1px); }
#contact-{{ section.id }} .cz__formnote { margin: 12px 0 0; font-size: 12px; line-height: 1.6; text-align: center; opacity: 0.55; }

#contact-{{ section.id }} .cz__note { display: flex; align-items: flex-start; gap: 10px; padding: 14px 16px; margin-bottom: 18px; font-size: 13.5px; line-height: 1.6; border-radius: 12px; }
#contact-{{ section.id }} .cz__note svg { flex-shrink: 0; width: 18px; height: 18px; margin-top: 1px; }
#contact-{{ section.id }} .cz__note--ok { background: {{ s.accent_color | color_modify: 'alpha', 0.26 }}; }
#contact-{{ section.id }} .cz__note--error { background: rgba(209,26,42,0.09); color: #a8121f; }

#contact-{{ section.id }} .cz__side { display: flex; flex-direction: column; gap: 12px; }
#contact-{{ section.id }} .cz__card { display: flex; gap: 14px; padding: 20px; text-decoration: none; color: inherit; border: 1px solid var(--cz-line); border-radius: 16px; transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease; }
#contact-{{ section.id }} a.cz__card:hover { border-color: {{ s.text_color | color_modify: 'alpha', 0.55 }}; transform: translateY(-2px); box-shadow: 0 16px 32px -24px rgba(10,10,10,0.6); }
#contact-{{ section.id }} .cz__card--wa { background: {{ s.accent_color | color_modify: 'alpha', 0.14 }}; border-color: {{ s.accent_color | color_modify: 'alpha', 0.55 }}; }
#contact-{{ section.id }} .cz__card-ic { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 12px; background: {{ s.accent_color | color_modify: 'alpha', 0.26 }}; }
#contact-{{ section.id }} .cz__card-ic svg { width: 21px; height: 21px; }
#contact-{{ section.id }} .cz__card-body { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
#contact-{{ section.id }} .cz__card-title { font-family: 'Zen Maru Gothic', sans-serif; font-size: 15px; font-weight: 700; }
#contact-{{ section.id }} .cz__card-text { font-size: 13px; line-height: 1.6; opacity: 0.65; overflow-wrap: anywhere; }
#contact-{{ section.id }} .cz__card-cta { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; font-size: 11.5px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }

#contact-{{ section.id }} .cz__socialwrap { display: flex; align-items: center; gap: 14px; padding: 16px 20px; border: 1px solid var(--cz-line); border-radius: 16px; }
#contact-{{ section.id }} .cz__social-label { font-size: 11px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.5; }
#contact-{{ section.id }} .cz__socials { display: flex; gap: 8px; }
#contact-{{ section.id }} .cz__social { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; color: var(--cz-text); border: 1px solid var(--cz-line); border-radius: 50%; transition: background-color 0.18s ease, border-color 0.18s ease; }
#contact-{{ section.id }} .cz__social svg { width: 17px; height: 17px; }
#contact-{{ section.id }} .cz__social:hover { background: var(--cz-accent); border-color: var(--cz-accent); }

#contact-{{ section.id }} .cz__faq { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 18px 20px; font-size: 13.5px; line-height: 1.55; font-weight: 600; color: #fff; text-decoration: none; background: var(--cz-text); border-radius: 16px; transition: gap 0.2s ease; }
#contact-{{ section.id }} .cz__faq svg { flex-shrink: 0; }
#contact-{{ section.id }} .cz__faq:hover { gap: 20px; }

@media (max-width: 989px) {
  #contact-{{ section.id }} .cz__layout { grid-template-columns: 1fr; gap: 24px; }
}
@media (max-width: 749px) {
  #contact-{{ section.id }} { padding: {{ s.padding_top | times: 0.6 | round }}px 0 {{ s.padding_bottom | times: 0.6 | round }}px; }
  #contact-{{ section.id }} .cz__inner { padding: 0 14px; }
  #contact-{{ section.id }} .cz__head { margin-bottom: 24px; }
  #contact-{{ section.id }} .cz__formwrap { padding: 20px 16px; border-radius: 16px; }
  #contact-{{ section.id }} .cz__row { grid-template-columns: 1fr; gap: 0; }
  #contact-{{ section.id }} .cz__input { height: 46px; font-size: 14px; }
}
@media (prefers-reduced-motion: reduce) {
  #contact-{{ section.id }} .cz__card, #contact-{{ section.id }} .cz__submit, #contact-{{ section.id }} .cz__faq { transition: none; }
}
{%- endstyle -%}

{% schema %}
{
  "name": "Contact page",
  "tag": "section",
  "class": "section-contact-zeene",
  "settings": [
    { "type": "header", "content": "Page header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We’re here to help" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about an order, a size or an exchange? Send us a message and our team will get back to you — usually within a few hours." },

    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send us a message" },
    { "type": "checkbox", "id": "show_order_field", "label": "Show “Order number” field", "default": true },
    { "type": "checkbox", "id": "show_topic_field", "label": "Show “What is this about?” dropdown", "default": true },
    { "type": "text", "id": "topics", "label": "Dropdown options", "default": "Order status, Exchange or return, Product or sizing, Payment issue, Something else", "info": "Separate with commas." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
