{%- style -%}
.gradient-slider.hero-slider { transition: background 0.3s ease; overflow: hidden; }
.gradient-slider .hero-slider__container { max-width: 100vw; margin: 0 auto; padding: 1rem; padding-top: calc(var(--hero-slider-top-offset, 16px) + env(safe-area-inset-top)); }
.gradient-slider .hero-slider__slide { position: relative; border-radius: {{ section.settings.corner_radius }}px; overflow: hidden; aspect-ratio: {{ section.settings.mobile_ratio }}; user-select: none; -webkit-user-select: none; width: 100%; max-width: 100%; }
.gradient-slider .hero-slider__link { position: absolute; inset: 0; z-index: 10; display: block; cursor: pointer; }
.gradient-slider .hero-slider__image { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transform: translateZ(0) scale(1.025); transition: opacity 0.55s ease, transform 1.25s cubic-bezier(.22,.61,.36,1); will-change: auto; }
.gradient-slider .hero-slider__image img { width: 100%; height: 100%; object-fit: cover; -webkit-user-drag: none; user-drag: none; pointer-events: none; }
.gradient-slider .hero-slider__image.active { opacity: 1; transform: translateZ(0) scale(1); z-index: 2; will-change: opacity, transform; }
.gradient-slider .hero-slider__dots { position: absolute; bottom: 1rem; left: 0; right: 0; display: flex; justify-content: center; gap: 0.75rem; z-index: 10; }
.gradient-slider .hero-slider__dot { width: 0.5rem; height: 0.5rem; background: rgba(255,255,255,.45); border-radius: 9999px; padding: 0; border: none; cursor: pointer; z-index: 30; transform: scale(1); transition: width 0.25s ease, background-color 0.25s ease, transform 0.25s ease; }
.gradient-slider .hero-slider__dot:hover { background: rgba(255,255,255,.8); }
.gradient-slider .hero-slider__dot.active { width: 2rem; background: {{ section.settings.dot_active_color }}; transform: scale(1.02); }
.gradient-slider .hero-slider__placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; background: #1a1a1a; color: #fff; }
.gradient-slider .hero-slider__placeholder svg { width: 40%; height: 40%; opacity: .4; }
@media (min-width: 640px) { .gradient-slider .hero-slider__slide { aspect-ratio: 16/9; } }
@media (min-width: 768px) { .gradient-slider .hero-slider__container { padding: 2rem; padding-top: var(--hero-slider-top-offset, 24px); } .gradient-slider .hero-slider__slide { aspect-ratio: {{ section.settings.desktop_ratio }}; } .gradient-slider .hero-slider__dots { bottom: 2rem; } }
@media (prefers-reduced-motion: reduce) { .gradient-slider .hero-slider__image { transition: opacity 0.2s linear !important; transform: none !important; will-change: auto; } }
{%- endstyle -%}

{%- liquid
  assign first_gradient = ''
  for block in section.blocks
    assign raw = block.settings.gradient_css | strip
    if raw != blank
      assign grad = raw
    elsif block.settings.gradient_color != blank
      assign grad = 'linear-gradient(to bottom, ' | append: block.settings.gradient_color | append: ', transparent)'
    else
      assign grad = 'linear-gradient(to bottom, #1a202c, transparent)'
    endif
    if first_gradient == blank
      assign first_gradient = grad
    endif
  endfor
-%}

<div
  class="hero-slider gradient-slider js-hero-slider"
  style="background: {{ first_gradient }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  <div class="hero-slider__container">
    <div class="hero-slider__slide js-slider-container">
      {%- for block in section.blocks -%}
        {%- liquid
          assign raw = block.settings.gradient_css | strip
          if raw != blank
            assign grad = raw
          elsif block.settings.gradient_color != blank
            assign grad = 'linear-gradient(to bottom, ' | append: block.settings.gradient_color | append: ', transparent)'
          else
            assign grad = 'linear-gradient(to bottom, #1a202c, transparent)'
          endif
          assign desktop_image = block.settings.desktop_image
          assign mobile_image = block.settings.mobile_image | default: desktop_image
          assign slide_title = block.settings.title | default: desktop_image.alt
        -%}
        <div class="hero-slider__image{% if forloop.first %} active{% endif %}" data-gradient="{{ grad | escape }}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="hero-slider__link"><span class="visually-hidden">{{ slide_title | default: 'View details' | escape }}</span></a>
          {%- endif -%}
          {%- if desktop_image != blank -%}
            <picture>
              <source media="(min-width: 768px)" srcset="{{ desktop_image | image_url: width: 1920 }}">
              <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 750 }}">
              <img
                src="{{ desktop_image | image_url: width: 1920 }}"
                alt="{{ desktop_image.alt | default: slide_title | escape }}"
                width="{{ desktop_image.width }}"
                height="{{ desktop_image.height }}"
                loading="{% if forloop.index <= 1 %}eager{% else %}lazy{% endif %}"
                fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
                decoding="async"
                draggable="false"
              >
            </picture>
          {%- else -%}
            <img class="hero-slider__demo-img" src="{% render 'demo-image', set: 'hero', index: forloop.index0, width: 1920 %}" alt="{{ slide_title | escape }}" width="1920" height="800" loading="{% if forloop.index <= 1 %}eager{% else %}lazy{% endif %}" decoding="async" draggable="false" style="width:100%;height:100%;object-fit:cover;">
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="hero-slider__image active"><div class="hero-slider__placeholder">{{ 'image' | placeholder_svg_tag }}</div></div>
      {%- endfor -%}

      {%- if section.blocks.size > 1 -%}
        <div class="hero-slider__dots js-slider-dots">
          {%- for block in section.blocks -%}
            <button type="button" class="hero-slider__dot{% if forloop.first %} active{% endif %}" aria-label="{{ 'sections.slideshow.load_slide' | t: slide_number: forloop.index }}" data-index="{{ forloop.index0 }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'hero-slider.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "section-hero-slider",
  "settings": [
    { "type": "header", "content": "Slider behavior" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay slides", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 3, "max": 10, "step": 1, "unit": "sec", "label": "Change slides every", "default": 5 },
    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 24 },
    { "type": "color", "id": "dot_active_color", "label": "Active dot color", "default": "#C6F135" },
    { "type": "select", "id": "mobile_ratio", "label": "Mobile aspect ratio", "options": [ { "value": "4/5", "label": "Portrait (4:5)" }, { "value": "1/1", "label": "Square (1:1)" }, { "value": "16/9", "label": "Wide (16:9)" } ], "default": "4/5" },
    { "type": "select", "id": "desktop_ratio", "label": "Desktop aspect ratio", "options": [ { "value": "24/9", "label": "Ultra wide (24:9)" }, { "value": "16/9", "label": "Wide (16:9)" }, { "value": "21/9", "label": "Cinematic (21:9)" } ], "default": "24/9" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "desktop_image", "label": "Desktop image", "info": "1920px wide recommended" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image", "info": "Optional. 750px wide recommended. Falls back to desktop image." },
        { "type": "url", "id": "link", "label": "Slide link (whole slide clickable)" },
        { "type": "text", "id": "title", "label": "Accessibility title", "info": "Describes the slide for screen readers." },
        { "type": "header", "content": "Background gradient" },
        { "type": "paragraph", "content": "Shows behind the image (during fade and on transparent edges). Use a single color OR a full CSS gradient below." },
        { "type": "color", "id": "gradient_color", "label": "Gradient base color", "default": "#C6F135" },
        { "type": "text", "id": "gradient_css", "label": "Custom CSS gradient (optional)", "info": "e.g. linear-gradient(135deg, #C6F135, #0a0a0a). Overrides the color above." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": [ { "type": "slide" }, { "type": "slide" } ]
    }
  ]
}
{% endschema %}
