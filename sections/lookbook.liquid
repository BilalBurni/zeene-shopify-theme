{%- liquid
  assign radius = section.settings.corner_radius
-%}

{%- style -%}
#lookbook-{{ section.id }} { background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
#lookbook-{{ section.id }} .lb__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 16px; }
#lookbook-{{ section.id }} .lb__head { text-align: left; max-width: none; margin: 0 0 30px; }
#lookbook-{{ section.id }} .lb__eyebrow { display: inline-block; margin: 0 0 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: {{ section.settings.text_color }}; opacity: 0.55; }
#lookbook-{{ section.id }} .lb__heading { margin: 0; font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(20px, 2.6vw, 26px); font-weight: 700; line-height: 1.3; color: {{ section.settings.text_color }}; }
#lookbook-{{ section.id }} .lb__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 340px; grid-auto-flow: dense; gap: {{ section.settings.gap }}px; }
#lookbook-{{ section.id }} .lb__tile { position: relative; display: block; border-radius: {{ radius }}px; overflow: hidden; background: #f0f0f0; text-decoration: none; isolation: isolate; }
#lookbook-{{ section.id }} .lb__tile--wide { grid-column: span 2; }
#lookbook-{{ section.id }} .lb__tile--tall { grid-row: span 2; }
#lookbook-{{ section.id }} .lb__tile--wide.lb__tile--tall { grid-column: span 2; grid-row: span 2; }
#lookbook-{{ section.id }} .lb__media { position: absolute; inset: 0; width: 100%; height: 100%; }
#lookbook-{{ section.id }} .lb__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s cubic-bezier(.22,.61,.36,1); will-change: transform; }
#lookbook-{{ section.id }} .lb__tile:hover .lb__media img { transform: scale(1.07); }
#lookbook-{{ section.id }} .lb__overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgba(8,8,8,0.7) 0%, rgba(8,8,8,0.05) 55%, rgba(8,8,8,0) 80%); opacity: 0.85; transition: opacity 0.4s ease; }
#lookbook-{{ section.id }} .lb__tile:hover .lb__overlay { opacity: 1; }
#lookbook-{{ section.id }} .lb__ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: #f4f4f4; }
#lookbook-{{ section.id }} .lb__ph svg { width: 32%; height: 32%; opacity: 0.4; fill: #b8b8b8; }
#lookbook-{{ section.id }} .lb__content { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 18px; display: flex; align-items: flex-end; justify-content: space-between; gap: 10px; }
#lookbook-{{ section.id }} .lb__label { display: block; margin: 0; font-size: 17px; font-weight: 800; line-height: 1.1; letter-spacing: -0.01em; color: #fff; }
#lookbook-{{ section.id }} .lb__cta { display: block; margin: 5px 0 0; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: {{ section.settings.accent_color }}; }
#lookbook-{{ section.id }} .lb__chip { flex-shrink: 0; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; border-radius: 9999px; background: {{ section.settings.accent_color }}; color: #0a0a0a; transform: translateY(8px) scale(0.85); opacity: 0; transition: transform 0.35s cubic-bezier(.22,.61,.36,1), opacity 0.3s ease; }
#lookbook-{{ section.id }} .lb__chip svg { width: 16px; height: 16px; }
#lookbook-{{ section.id }} .lb__tile:hover .lb__chip { transform: translateY(0) scale(1); opacity: 1; }
@media (max-width: 989px) { #lookbook-{{ section.id }} .lb__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 300px; } #lookbook-{{ section.id }} .lb__tile--wide { grid-column: span 2; grid-row: span 1; } #lookbook-{{ section.id }} .lb__tile--tall { grid-column: span 1; grid-row: span 1; } #lookbook-{{ section.id }} .lb__tile--wide.lb__tile--tall { grid-column: span 2; grid-row: span 1; } }
@media (max-width: 749px) { #lookbook-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.5 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round }}px; } #lookbook-{{ section.id }} .lb__grid { gap: 10px; grid-auto-rows: 52vw; } #lookbook-{{ section.id }} .lb__chip { opacity: 1; transform: none; } #lookbook-{{ section.id }} .lb__label { font-size: 15px; } }
@media (prefers-reduced-motion: reduce) { #lookbook-{{ section.id }} .lb__media img, #lookbook-{{ section.id }} .lb__chip { transition: none !important; } #lookbook-{{ section.id }} .lb__tile:hover .lb__media img { transform: none; } }
{%- endstyle -%}

<div id="lookbook-{{ section.id }}" class="lb">
  <div class="lb__inner">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="lb__head">
        {%- if section.settings.eyebrow != blank -%}<span class="lb__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="lb__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="lb__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          assign tile_class = 'lb__tile'
          if block.settings.size == 'wide'
            assign tile_class = 'lb__tile lb__tile--wide'
          elsif block.settings.size == 'tall'
            assign tile_class = 'lb__tile lb__tile--tall'
          elsif block.settings.size == 'feature'
            assign tile_class = 'lb__tile lb__tile--wide lb__tile--tall'
          endif
        -%}
        <a href="{{ block.settings.link | default: '#' }}" class="{{ tile_class }}" {{ block.shopify_attributes }} aria-label="{{ block.settings.label | default: 'Look' | escape }}">
          <span class="lb__media">
            {%- if img != blank -%}
              <img src="{{ img | image_url: width: 900 }}" srcset="{{ img | image_url: width: 500 }} 500w, {{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1300 }} 1300w" sizes="(max-width: 749px) 50vw, 25vw" alt="{{ img.alt | default: block.settings.label | escape }}" width="{{ img.width }}" height="{{ img.height }}" loading="lazy" decoding="async">
            {%- else -%}
              <img src="{% render 'demo-image', set: 'lifestyle', index: forloop.index0, width: 900 %}" alt="{{ block.settings.label | escape }}" width="900" height="1200" loading="lazy" decoding="async">
            {%- endif -%}
          </span>
          <span class="lb__overlay"></span>
          <span class="lb__content">
            <span>
              {%- if block.settings.label != blank -%}<span class="lb__label">{{ block.settings.label }}</span>{%- endif -%}
              {%- if block.settings.cta != blank -%}<span class="lb__cta">{{ block.settings.cta }}</span>{%- endif -%}
            </span>
            <span class="lb__chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </span>
        </a>
      {%- else -%}
        {%- for i in (1..4) -%}
          <span class="lb__tile"><span class="lb__ph">{{ 'lifestyle-2' | placeholder_svg_tag }}</span><span class="lb__overlay"></span><span class="lb__content"><span><span class="lb__label">Look {{ i }}</span></span></span></span>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section-lookbook",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Styled by Zeene" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "gap", "min": 4, "max": 24, "step": 2, "unit": "px", "label": "Gap", "default": 12 },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Corner radius", "default": 16 },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max content width", "default": 1280 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Neon accent", "default": "#C6F135" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "size", "label": "Tile size", "options": [ { "value": "regular", "label": "Regular (1x1)" }, { "value": "wide", "label": "Wide (2 cols)" }, { "value": "tall", "label": "Tall (2 rows)" }, { "value": "feature", "label": "Feature (big 2x2)" } ], "default": "regular" },
        { "type": "text", "id": "label", "label": "Label", "default": "New Season" },
        { "type": "text", "id": "cta", "label": "Small CTA text", "default": "Shop the look" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "tile", "settings": { "size": "feature", "label": "The Winter Edit" } },
        { "type": "tile", "settings": { "size": "regular", "label": "Hoodies" } },
        { "type": "tile", "settings": { "size": "regular", "label": "Trousers" } },
        { "type": "tile", "settings": { "size": "wide", "label": "Fragrance" } }
      ]
    }
  ]
}
{% endschema %}
