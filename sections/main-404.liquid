{%- liquid
  assign s = section.settings
  assign menu = s.menu

  assign ar = s.accent_color | color_extract: 'red'
  assign ag = s.accent_color | color_extract: 'green'
  assign ab = s.accent_color | color_extract: 'blue'
-%}
{%- capture tint -%}rgba({{ ar }}, {{ ag }}, {{ ab }}, 0.16){%- endcapture -%}

{%- style -%}
#e404-{{ section.id }} { background: {{ s.bg_color }}; padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px; }
#e404-{{ section.id }} .e404__inner { max-width: {{ s.max_width }}px; margin: 0 auto; padding: 0 16px; text-align: center; }

{%- comment -%} display:block is required: inline-block puts the eyebrow badge and the number in the same line box. {%- endcomment -%}
#e404-{{ section.id }} .e404__num { position: relative; isolation: isolate; display: block; margin: 4px 0 2px; font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp({{ s.number_size | times: 0.55 | round }}px, 11vw, {{ s.number_size }}px); font-weight: 800; line-height: 1; letter-spacing: -0.045em; color: {{ s.number_color }}; }
#e404-{{ section.id }} .e404__num::before { content: ''; position: absolute; left: 50%; top: 50%; width: 1.7em; height: 1.05em; transform: translate(-50%, -50%); background: {{ s.accent_color }}; filter: blur(42px); opacity: 0.38; border-radius: 50%; z-index: -1; }
#e404-{{ section.id }} .e404__eyebrow { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 18px; padding: 6px 14px; border-radius: 100px; background: {{ tint }}; font-size: 11.5px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: {{ s.text_color }}; }
#e404-{{ section.id }} .e404__dot { width: 6px; height: 6px; border-radius: 50%; background: {{ s.accent_color }}; }
#e404-{{ section.id }} .e404__heading { margin: 10px 0 0; font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(20px, 3vw, 28px); font-weight: 500; line-height: 1.3; letter-spacing: -0.01em; color: {{ s.text_color }}; }
#e404-{{ section.id }} .e404__sub { margin: 12px auto 0; max-width: 460px; font-size: 14px; line-height: 1.65; color: {{ s.text_color }}; opacity: 0.6; }

#e404-{{ section.id }} .e404__search { margin: 26px auto 0; max-width: 440px; display: flex; align-items: center; gap: 8px; padding: 5px 5px 5px 18px; background: {{ s.field_bg }}; border: 1px solid {{ s.field_border }}; border-radius: 100px; transition: border-color 0.2s ease; }
#e404-{{ section.id }} .e404__search:focus-within { border-color: {{ s.text_color }}; }
#e404-{{ section.id }} .e404__search input { flex: 1; min-width: 0; height: 42px; border: 0; background: none; font-family: inherit; font-size: 14px; color: {{ s.text_color }}; }
#e404-{{ section.id }} .e404__search input:focus { outline: none; }
#e404-{{ section.id }} .e404__search input::placeholder { color: {{ s.text_color }}; opacity: 0.42; }
#e404-{{ section.id }} .e404__search button { flex: 0 0 auto; width: 42px; height: 42px; display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 50%; background: {{ s.button_bg }}; color: {{ s.button_text }}; cursor: pointer; transition: transform 0.2s ease, filter 0.2s ease; }
#e404-{{ section.id }} .e404__search button:hover { transform: scale(1.06); filter: brightness(1.1); }

#e404-{{ section.id }} .e404__actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-top: 24px; }
#e404-{{ section.id }} .e404__btn { display: inline-flex; align-items: center; gap: 9px; min-height: 48px; padding: 0 26px; border-radius: 100px; font-family: 'Zen Maru Gothic', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; text-decoration: none; transition: transform 0.2s ease, filter 0.2s ease, background-color 0.2s ease, color 0.2s ease; }
#e404-{{ section.id }} .e404__btn--primary { background: {{ s.button_bg }}; color: {{ s.button_text }}; }
#e404-{{ section.id }} .e404__btn--primary:hover { transform: translateY(-2px); filter: brightness(1.12); }
#e404-{{ section.id }} .e404__btn--ghost { background: transparent; color: {{ s.text_color }}; border: 1px solid {{ s.field_border }}; }
#e404-{{ section.id }} .e404__btn--ghost:hover { background: {{ s.text_color }}; color: {{ s.bg_color }}; border-color: {{ s.text_color }}; transform: translateY(-2px); }

#e404-{{ section.id }} .e404__links { margin-top: 40px; padding-top: 28px; border-top: 1px solid {{ s.field_border }}; }
#e404-{{ section.id }} .e404__links-title { margin: 0 0 14px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: {{ s.text_color }}; opacity: 0.45; }
#e404-{{ section.id }} .e404__chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
#e404-{{ section.id }} .e404__chip { display: inline-flex; align-items: center; padding: 9px 16px; border: 1px solid {{ s.field_border }}; border-radius: 100px; font-size: 12.5px; font-weight: 500; color: {{ s.text_color }}; text-decoration: none; transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease; }
#e404-{{ section.id }} .e404__chip:hover { background: {{ s.text_color }}; color: {{ s.bg_color }}; border-color: {{ s.text_color }}; transform: translateY(-2px); }

@media (max-width: 749px) {
  #e404-{{ section.id }} { padding-top: {{ s.padding_top | times: 0.62 | round }}px; padding-bottom: {{ s.padding_bottom | times: 0.62 | round }}px; }
  #e404-{{ section.id }} .e404__inner { padding: 0 18px; }
  #e404-{{ section.id }} .e404__sub { font-size: 13px; }
  #e404-{{ section.id }} .e404__actions { gap: 10px; }
  #e404-{{ section.id }} .e404__btn { flex: 1 1 100%; justify-content: center; min-height: 46px; }
  #e404-{{ section.id }} .e404__links { margin-top: 32px; }
  #e404-{{ section.id }} .e404__chip { font-size: 12px; padding: 8px 14px; }
}
@media (prefers-reduced-motion: reduce) {
  #e404-{{ section.id }} .e404__btn, #e404-{{ section.id }} .e404__chip, #e404-{{ section.id }} .e404__search button { transition: none; }
  #e404-{{ section.id }} .e404__btn:hover, #e404-{{ section.id }} .e404__chip:hover, #e404-{{ section.id }} .e404__search button:hover { transform: none; }
}
{%- endstyle -%}

<div id="e404-{{ section.id }}" class="e404">
  <div class="e404__inner">
    {%- if s.eyebrow != blank -%}
      <span class="e404__eyebrow"><span class="e404__dot"></span>{{ s.eyebrow }}</span>
    {%- endif -%}

    <div class="e404__num">404</div>

    <h1 class="e404__heading">{{ s.heading | default: 'This page has gone missing' }}</h1>
    {%- if s.subtext != blank -%}<p class="e404__sub">{{ s.subtext }}</p>{%- endif -%}

    {%- if s.show_search -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="e404__search">
        <input type="search" name="q" placeholder="{{ s.search_placeholder | escape }}" aria-label="{{ s.search_placeholder | escape }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" aria-label="Search">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        </button>
      </form>
    {%- endif -%}

    <div class="e404__actions">
      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="e404__btn e404__btn--primary">
          {{ s.button_label }}
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      {%- endif -%}
      {%- if s.button_2_label != blank -%}
        <a href="{{ s.button_2_link | default: routes.root_url }}" class="e404__btn e404__btn--ghost">{{ s.button_2_label }}</a>
      {%- endif -%}
    </div>

    {%- if s.show_links and menu.links.size > 0 -%}
      <div class="e404__links">
        {%- if s.links_title != blank -%}<p class="e404__links-title">{{ s.links_title }}</p>{%- endif -%}
        <div class="e404__chips">
          {%- for link in menu.links limit: s.links_limit -%}
            <a class="e404__chip" href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section-404",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Page not found" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has gone missing" },
    { "type": "textarea", "id": "subtext", "label": "Text", "default": "The link may be broken, or the page may have been moved. Let's get you back to shopping." },

    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "show_search", "label": "Show search bar", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search for hoodies, tees, trousers..." },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop all products" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_2_label", "label": "Secondary button", "default": "Back to home" },
    { "type": "url", "id": "button_2_link", "label": "Secondary button link" },

    { "type": "header", "content": "Popular links" },
    { "type": "checkbox", "id": "show_links", "label": "Show category links", "default": true },
    { "type": "text", "id": "links_title", "label": "Links heading", "default": "Popular categories" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "range", "id": "links_limit", "min": 3, "max": 12, "step": 1, "label": "How many links", "default": 8 },

    { "type": "header", "content": "Colors & spacing" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0a0a0a" },
    { "type": "color", "id": "number_color", "label": "404 number", "default": "#0a0a0a" },
    { "type": "range", "id": "number_size", "min": 48, "max": 200, "step": 4, "unit": "px", "label": "404 number size", "default": 108 },
    { "type": "color", "id": "accent_color", "label": "Accent / glow", "default": "#c6f135" },
    { "type": "color", "id": "button_bg", "label": "Button background", "default": "#0a0a0a" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "field_bg", "label": "Search field background", "default": "#ffffff" },
    { "type": "color", "id": "field_border", "label": "Borders", "default": "#e2e2e2" },
    { "type": "range", "id": "max_width", "min": 600, "max": 1280, "step": 20, "unit": "px", "label": "Max content width", "default": 760 },
    { "type": "range", "id": "padding_top", "min": 20, "max": 160, "step": 4, "unit": "px", "label": "Padding top", "default": 88 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 160, "step": 4, "unit": "px", "label": "Padding bottom", "default": 96 }
  ]
}
{% endschema %}
