{%- liquid
  assign has_image = false
  if section.settings.bg_image != blank
    assign has_image = true
  endif
-%}

{%- style -%}
#newsletter-{{ section.id }} { background: {{ section.settings.bg_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
#newsletter-{{ section.id }} .nl__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 16px; }
#newsletter-{{ section.id }} .nl__card { position: relative; border-radius: {{ section.settings.corner_radius }}px; overflow: hidden; padding: clamp(36px, 6vw, 72px) clamp(20px, 5vw, 64px); text-align: center; isolation: isolate; background: {{ section.settings.card_color }}; }
#newsletter-{{ section.id }} .nl__bg { position: absolute; inset: 0; z-index: 0; }
#newsletter-{{ section.id }} .nl__bg img { width: 100%; height: 100%; object-fit: cover; opacity: {{ section.settings.image_opacity | divided_by: 100.0 }}; }
#newsletter-{{ section.id }} .nl__glow { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(120% 90% at 50% 0%, {{ section.settings.accent_color | append: '22' }} 0%, transparent 55%); }
#newsletter-{{ section.id }} .nl__content { position: relative; z-index: 2; max-width: 560px; margin: 0 auto; }
#newsletter-{{ section.id }} .nl__eyebrow { display: inline-block; margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: {{ section.settings.text_color }}; opacity: 0.55; }
#newsletter-{{ section.id }} .nl__heading { margin: 0; font-size: clamp(26px, 4.5vw, 44px); font-weight: 800; line-height: 1.04; letter-spacing: -0.015em; color: {{ section.settings.text_color }}; }
#newsletter-{{ section.id }} .nl__sub { margin: 12px 0 0; font-size: 15px; line-height: 1.5; color: {{ section.settings.text_color }}; opacity: 0.7; }
#newsletter-{{ section.id }} .nl__form { display: flex; gap: 8px; max-width: 460px; margin: 26px auto 0; }
#newsletter-{{ section.id }} .nl__input { flex: 1 1 auto; min-width: 0; height: 52px; padding: 0 18px; font-size: 15px; color: {{ section.settings.text_color }}; background: {{ section.settings.field_bg }}; border: 1px solid {{ section.settings.field_border }}; border-radius: 9999px; outline: none; transition: border-color 0.2s ease; }
#newsletter-{{ section.id }} .nl__input::placeholder { color: {{ section.settings.text_color }}; opacity: 0.45; }
#newsletter-{{ section.id }} .nl__input:focus { border-color: {{ section.settings.accent_color }}; }
#newsletter-{{ section.id }} .nl__btn { flex-shrink: 0; height: 52px; padding: 0 26px; font-size: 14px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: #0a0a0a; background: {{ section.settings.accent_color }}; border: none; border-radius: 9999px; cursor: pointer; transition: transform 0.2s ease, filter 0.2s ease; }
#newsletter-{{ section.id }} .nl__btn:hover { filter: brightness(1.06); transform: translateY(-1px); }
#newsletter-{{ section.id }} .nl__success { margin: 22px auto 0; padding: 12px 20px; max-width: 460px; font-size: 14px; font-weight: 600; color: #0a0a0a; background: {{ section.settings.accent_color }}; border-radius: 9999px; }
#newsletter-{{ section.id }} .nl__error { margin: 14px auto 0; font-size: 13px; color: #ff6b6b; }
@media (max-width: 749px) { #newsletter-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.5 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round }}px; } }
@media (max-width: 600px) { #newsletter-{{ section.id }} .nl__form { flex-direction: column; align-items: stretch; } #newsletter-{{ section.id }} .nl__btn { width: 100%; } }
{%- endstyle -%}

<div id="newsletter-{{ section.id }}" class="nl">
  <div class="nl__inner">
    <div class="nl__card">
      {%- if has_image -%}<span class="nl__bg"><img src="{{ section.settings.bg_image | image_url: width: 1600 }}" alt="" width="{{ section.settings.bg_image.width }}" height="{{ section.settings.bg_image.height }}" loading="lazy" decoding="async"></span>{%- endif -%}
      <span class="nl__glow"></span>
      <div class="nl__content">
        {%- if section.settings.eyebrow != blank -%}<span class="nl__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="nl__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="nl__sub">{{ section.settings.subheading }}</p>{%- endif -%}
        {%- form 'customer', class: 'nl__form' -%}
          {%- if form.posted_successfully? -%}{%- assign nl_posted = true -%}{%- endif -%}
          {%- if form.errors -%}{%- assign nl_error = form.errors.messages.email -%}{%- endif -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input class="nl__input" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}" required aria-label="Email">
          <button type="submit" class="nl__btn">{{ section.settings.button_label | default: 'Subscribe' }}</button>
        {%- endform -%}
        {%- if nl_posted -%}<p class="nl__success">{{ section.settings.success_text | default: 'Thanks for subscribing — welcome to Zeene.' }}</p>{%- endif -%}
        {%- if nl_error -%}<p class="nl__error">{{ nl_error | default: 'Please enter a valid email.' }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter CTA",
  "tag": "section",
  "class": "section-newsletter-cta",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% Off Your First Order" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Early access to drops, offers & restocks." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks for subscribing — welcome to Zeene." },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (optional)" },
    { "type": "range", "id": "image_opacity", "min": 10, "max": 100, "step": 5, "unit": "%", "label": "Image opacity", "default": 45 },
    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 24 },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max content width", "default": 1280 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#f5f5f5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Neon accent", "default": "#C6F135" },
    { "type": "color", "id": "field_bg", "label": "Input background", "default": "#ffffff" },
    { "type": "color", "id": "field_border", "label": "Input border", "default": "#e0e0e0" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "presets": [
    { "name": "Newsletter CTA" }
  ]
}
{% endschema %}
