{%- liquid
  assign s = section.settings
  assign cols = s.columns_desktop
  assign radius = s.corner_radius
  assign ratio = s.image_ratio
  assign products = collections[s.collection].products
  assign limit = s.products_to_show
  assign pt_m = s.padding_top | times: 0.5 | round
  assign pb_m = s.padding_bottom | times: 0.5 | round
-%}
{{ 'zeene-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'zeene-card.js' | asset_url }}" defer="defer"></script>

<div id="product-grid-{{ section.id }}" class="pg zeene-pg{% if s.mobile_slider %} is-mslider{% endif %}" style="--pg-bg:{{ s.bg_color }};--pg-text:{{ s.text_color }};--pg-accent:{{ s.accent_color }};--pg-star:{{ s.star_color }};--pg-radius:{{ radius }}px;--pg-ratio:{{ ratio }};--pg-cols:{{ cols }};--pg-gap:{{ s.gap }}px;--pg-maxw:{{ s.max_width }}px;--pg-mcw:{{ s.mobile_card_width }}%;--pg-pt:{{ s.padding_top }}px;--pg-pb:{{ s.padding_bottom }}px;--pg-pt-m:{{ pt_m }}px;--pg-pb-m:{{ pb_m }}px;">
  <div class="pg__inner">
    {%- if s.heading != blank or s.eyebrow != blank or s.view_all_link != blank -%}
      <div class="pg__head">
        <div>
          {%- if s.eyebrow != blank -%}<span class="pg__eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="pg__heading">{{ s.heading }}</h2>{%- endif -%}
          {%- if s.subheading != blank -%}<p class="pg__sub">{{ s.subheading }}</p>{%- endif -%}
        </div>
        {%- if s.view_all_link != blank -%}
          <a href="{{ s.view_all_link }}" class="pg__viewall">{{ s.view_all_label | default: 'View all' }}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pg__track js-pg-track">
      {%- for product in products limit: limit -%}
        {%- render 'zeene-card', product: product, cols: cols, show_swatches: s.show_swatches, max_swatches: s.max_swatches, show_quick_add: s.show_quick_add, show_sizes: s.show_sizes, show_sale_badge: s.show_sale_badge, show_vendor: s.show_vendor, show_rating: s.show_rating, show_rating_count: s.show_rating_count, rating_fallback: s.rating_fallback -%}
      {%- else -%}
        {%- assign demo_titles = 'Classic Cotton Tee,Slim Fit Trousers,Oversized Hoodie,Essential Crew Tee,Tapered Joggers,Signature Eau de Parfum,Pima Polo Shirt,Relaxed Denim' | split: ',' -%}
        {%- assign demo_prices = '149900,299900,349900,129900,249900,499900,199900,329900' | split: ',' -%}
        {%- for i in (1..limit) -%}
          {%- liquid
            assign di = forloop.index0
            assign ci = di | modulo: 8
            assign dt = demo_titles[ci]
            assign dp = demo_prices[ci]
          -%}
          <div class="pc">
            <span class="pc__media">
              <span class="pc__slide pc__slide--single"><img src="{% render 'demo-image', set: 'product', index: di, width: 600 %}" alt="{{ dt }}" width="600" height="600" loading="lazy" decoding="async"></span>
            </span>
            <div class="pc__info">
              <h3 class="pc__title"><a href="#">{{ dt }}</a></h3>
              <div class="pc__price"><span>{{ dp | times: 1 | money }}</span></div>
              {%- if s.show_swatches -%}
                <div class="pc__swatches"><span class="pc__swatch is-active" style="background-color:#0a0a0a"></span><span class="pc__swatch" style="background-color:#f4f4f4"></span><span class="pc__swatch" style="background-color:#C6F135"></span></div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "class": "section-product-grid",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (small label above)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 6, "step": 1, "label": "Desktop columns", "default": 5 },
    { "type": "select", "id": "image_ratio", "label": "Image aspect ratio", "options": [ { "value": "1/1", "label": "Square (1:1)" }, { "value": "4/5", "label": "Portrait (4:5)" }, { "value": "3/4", "label": "Portrait (3:4)" }, { "value": "2/3", "label": "Tall portrait (2:3)" } ], "default": "3/4" },
    { "type": "range", "id": "gap", "min": 4, "max": 28, "step": 2, "unit": "px", "label": "Gap between cards", "default": 16 },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Image corner radius", "default": 14 },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max content width", "default": 1280 },
    { "type": "header", "content": "Card content" },
    { "type": "checkbox", "id": "show_swatches", "label": "Show color swatches", "default": true },
    { "type": "range", "id": "max_swatches", "min": 3, "max": 8, "step": 1, "label": "Max swatches before \"+N\"", "default": 5 },
    { "type": "checkbox", "id": "show_second_image", "label": "Swap to 2nd image on hover", "default": true },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick \"+\" button", "default": false },
    { "type": "checkbox", "id": "show_sizes", "label": "Show size buttons on hover (add to cart)", "default": true, "info": "Needs a 'Size' option on products. Click a size to add to cart." },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show sale badge", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating (Judge.me)", "default": true, "info": "Reads Judge.me cached badge (judgeme.badge metafield). Requires Judge.me 'cache badges' on." },
    { "type": "checkbox", "id": "show_rating_count", "label": "Show review count next to rating", "default": false },
    { "type": "checkbox", "id": "rating_fallback", "label": "Show 5.0 placeholder when no reviews", "default": false },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#f5a623" },
    { "type": "header", "content": "Mobile" },
    { "type": "checkbox", "id": "mobile_slider", "label": "Swipe slider on mobile", "default": true, "info": "Off = 2-column grid." },
    { "type": "range", "id": "mobile_card_width", "min": 50, "max": 85, "step": 5, "unit": "%", "label": "Mobile card width (slider)", "default": 65 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Neon accent", "default": "#C6F135" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "presets": [
    {
      "name": "Product Grid",
      "settings": { "collection": "all", "products_to_show": 10, "columns_desktop": 5 }
    }
  ]
}
{% endschema %}
