{%- comment -%}
  Product reviews — Judge.me review widget.
  Renders the cached widget metafield; Judge.me JS refreshes it live.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
-%}
<div class="pr-reviews" style="background: {{ s.bg_color }}; padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;">
  <div class="pr-reviews__inner" style="max-width: {{ s.max_width }}px; margin: 0 auto; padding: 0 16px;">
    {%- if s.heading != blank -%}
      <h2 class="pr-reviews__heading">{{ s.heading }}</h2>
    {%- endif -%}
    <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.widget }}
    </div>
  </div>
</div>

{%- style -%}
#shopify-section-{{ section.id }} .pr-reviews { overflow-x: hidden; }
#shopify-section-{{ section.id }} .pr-reviews__heading { margin: 0 0 28px; font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(20px, 2.6vw, 26px); font-weight: 500; line-height: 1.3; color: {{ s.text_color }}; text-align: {{ s.heading_align }}; }
#shopify-section-{{ section.id }} .jdgm-widget { font-family: 'Zen Maru Gothic', sans-serif; max-width: 100%; }
{%- if s.heading != blank -%}#shopify-section-{{ section.id }} .jdgm-rev-widg__title { display: none; }{%- endif -%}
#shopify-section-{{ section.id }} .jdgm-widget img, #shopify-section-{{ section.id }} .jdgm-widget iframe, #shopify-section-{{ section.id }} .jdgm-widget table { max-width: 100%; }
#shopify-section-{{ section.id }} .jdgm-widget * { overflow-wrap: break-word; }
@media (max-width: 749px) { #shopify-section-{{ section.id }} .pr-reviews__heading { font-size: 24px; margin-bottom: 18px; } }
{%- endstyle -%}

{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "class": "section-product-reviews",
  "settings": [
    { "type": "paragraph", "content": "Shows the Judge.me review widget. Requires the Judge.me app embed enabled in your theme (Customize → App embeds)." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "range", "id": "max_width", "min": 800, "max": 1400, "step": 20, "unit": "px", "label": "Max content width", "default": 1100 },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Heading text", "default": "#0a0a0a" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "presets": [
    { "name": "Product reviews" }
  ]
}
{% endschema %}
