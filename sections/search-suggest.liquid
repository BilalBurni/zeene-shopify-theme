{%- comment -%}
  Zeene predictive search results — fetched via
  /search/suggest?q=QUERY&section_id=search-suggest&resources[type]=product,query&resources[limit]=8
{%- endcomment -%}
{%- if predictive_search.performed -%}
  <div class="sd-results-inner">
    {%- if predictive_search.resources.queries.size > 0 -%}
      <div class="sd__section">
        <div class="sd__label">Suggestions</div>
        <div class="sd__pills">
          {%- for q in predictive_search.resources.queries limit: 4 -%}
            <a class="sd__pill" href="{{ q.url }}">{{ q.text }}</a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
    {%- if predictive_search.resources.products.size > 0 -%}
      <div class="sd__section">
        <div class="sd__label">Products</div>
        <div class="sd__list">
          {%- for product in predictive_search.resources.products -%}
            {%- render 'search-result-card', product: product -%}
          {%- endfor -%}
        </div>
      </div>
      <a class="sd__viewall" href="{{ routes.search_url }}?q={{ predictive_search.terms | escape }}&options[prefix]=last">View all results &rarr;</a>
    {%- else -%}
      <div class="sd__empty">
        <p class="sd__empty-title">No products found</p>
        <p class="sd__empty-sub">Try another search term.</p>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Search suggest"
}
{% endschema %}
