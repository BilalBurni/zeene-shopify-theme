{%- liquid
  assign img = section.settings.image
  assign radius = section.settings.corner_radius
-%}

{%- style -%}
#stl-{{ section.id }} { background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
#stl-{{ section.id }} .stl__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 16px; }
#stl-{{ section.id }} .stl__head { margin: 0 0 26px; }
#stl-{{ section.id }} .stl__heading { margin: 0; font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(20px, 2.6vw, 26px); font-weight: 700; line-height: 1.3; }
#stl-{{ section.id }} .stl__sub { margin: 10px 0 0; font-size: 14px; line-height: 1.5; opacity: 0.65; }
#stl-{{ section.id }} .stl__stage { position: relative; border-radius: {{ radius }}px; overflow: hidden; background: #f0f0f0; }
#stl-{{ section.id }} .stl__stage > img { display: block; width: 100%; height: auto; }
#stl-{{ section.id }} .stl__ph { aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; }
#stl-{{ section.id }} .stl__ph svg { width: 20%; height: 20%; opacity: 0.4; fill: #b8b8b8; }
#stl-{{ section.id }} .stl__spot { position: absolute; z-index: 2; left: var(--x); top: var(--y); width: 0; height: 0; }
#stl-{{ section.id }} .stl__stage > img.stl__img--mob { display: none; }
#stl-{{ section.id }} .stl__dot { position: absolute; left: 0; top: 0; display: block; width: 18px; height: 18px; padding: 0; border: 0; border-radius: 9999px; background: {{ section.settings.dot_color }}; box-shadow: 0 0 0 2px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.3); cursor: pointer; transform: translate(-50%, -50%); transition: background-color 0.2s ease; }
#stl-{{ section.id }} .stl__dot::after { content: ''; position: absolute; inset: -7px; border-radius: 9999px; border: 2px solid {{ section.settings.dot_color }}; animation: stlPulse-{{ section.id }} 2.2s ease-out infinite; }
#stl-{{ section.id }} .stl__spot:hover .stl__dot, #stl-{{ section.id }} .stl__spot.is-open .stl__dot { background: {{ section.settings.accent_color }}; }
@keyframes stlPulse-{{ section.id }} { 0% { transform: scale(0.7); opacity: 0.85; } 100% { transform: scale(1.7); opacity: 0; } }
#stl-{{ section.id }} .stl__label { position: absolute; z-index: 4; top: 50%; transform: translateY(-50%); display: inline-flex; align-items: center; gap: 8px; max-width: 250px; padding: 8px 14px; background: #fff; color: #0a0a0a; font-size: 13px; font-weight: 600; line-height: 1; white-space: nowrap; border-radius: 9999px; box-shadow: 0 6px 20px rgba(0,0,0,0.18); opacity: 1; visibility: visible; pointer-events: none; transition: opacity 0.2s ease; }
#stl-{{ section.id }} .stl__label--right { left: calc(100% + 14px); }
#stl-{{ section.id }} .stl__label--left { right: calc(100% + 14px); flex-direction: row-reverse; }
#stl-{{ section.id }} .stl__label-text { overflow: hidden; text-overflow: ellipsis; }
#stl-{{ section.id }} .stl__label svg { flex-shrink: 0; width: 13px; height: 13px; }
#stl-{{ section.id }} .stl__spot:hover .stl__label { opacity: 1; visibility: visible; }
#stl-{{ section.id }} .stl__spot.is-open .stl__label { opacity: 0; visibility: hidden; }
#stl-{{ section.id }} .stl__card { position: absolute; z-index: 5; width: 330px; max-width: 80vw; display: none; background: #fff; color: #0a0a0a; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,0.20); border: 1px solid rgba(0,0,0,0.06); }
#stl-{{ section.id }} .stl__spot.is-open .stl__card { display: flex; }
#stl-{{ section.id }} .stl__card--right { left: calc(100% + 18px); }
#stl-{{ section.id }} .stl__card--left { right: calc(100% + 18px); }
#stl-{{ section.id }} .stl__card--down { top: -16px; }
#stl-{{ section.id }} .stl__card--up { bottom: -16px; }
#stl-{{ section.id }} .stl__thumb { flex: 0 0 42%; display: block; align-self: stretch; background: #f4f4f4; min-height: 150px; }
#stl-{{ section.id }} .stl__thumb img { width: 100%; height: 100%; object-fit: cover; }
#stl-{{ section.id }} .stl__body { flex: 1; min-width: 0; padding: 16px; display: flex; flex-direction: column; gap: 9px; }
#stl-{{ section.id }} .stl__name { font-size: 14px; font-weight: 700; line-height: 1.4; color: #0a0a0a; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
#stl-{{ section.id }} .stl__name:hover { text-decoration: underline; text-underline-offset: 2px; }
#stl-{{ section.id }} .stl__price { display: flex; align-items: baseline; gap: 8px; font-size: 16px; font-weight: 800; }
#stl-{{ section.id }} .stl__price--sale { color: #d11a2a; }
#stl-{{ section.id }} .stl__price s { font-size: 13px; font-weight: 500; opacity: 0.45; color: #0a0a0a; }
#stl-{{ section.id }} .stl__buy { margin-top: 4px; width: 100%; padding: 12px; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #0a0a0a; background: {{ section.settings.accent_color }}; border: 0; border-radius: 10px; cursor: pointer; transition: filter 0.2s ease; }
#stl-{{ section.id }} .stl__buy:hover { filter: brightness(1.05); }
#stl-{{ section.id }} .stl__close { display: none; }
@media (max-width: 749px) {
  #stl-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.5 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round }}px; }
  #stl-{{ section.id }} .stl__spot { left: var(--xm); top: var(--ym); }
  {%- if section.settings.mobile_image != blank -%}
  #stl-{{ section.id }} .stl__stage > img.stl__img--desk { display: none; }
  #stl-{{ section.id }} .stl__stage > img.stl__img--mob { display: block; }
  {%- endif -%}
  #stl-{{ section.id }} .stl__card { width: 215px; max-width: 72vw; }
  #stl-{{ section.id }} .stl__thumb { flex: 0 0 40%; min-height: 105px; }
  #stl-{{ section.id }} .stl__body { padding: 11px; gap: 6px; }
  #stl-{{ section.id }} .stl__name { font-size: 12.5px; }
  #stl-{{ section.id }} .stl__price { font-size: 13px; }
  #stl-{{ section.id }} .stl__buy { padding: 9px; font-size: 10.5px; }
  #stl-{{ section.id }} .stl__label { display: none; }
}
@media (prefers-reduced-motion: reduce) { #stl-{{ section.id }} .stl__dot::after { animation: none; } }
{%- endstyle -%}

<div id="stl-{{ section.id }}" class="stl">
  <div class="stl__inner">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="stl__head">
        {%- if section.settings.heading != blank -%}<h2 class="stl__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="stl__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="stl__stage js-stl-stage">
      {%- if img != blank -%}
        <img class="stl__img stl__img--desk" src="{{ img | image_url: width: 1600 }}" srcset="{{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2000 }} 2000w" sizes="(max-width: {{ section.settings.max_width }}px) 100vw, {{ section.settings.max_width }}px" alt="{{ img.alt | default: section.settings.heading | escape }}" width="{{ img.width }}" height="{{ img.height }}" loading="lazy" decoding="async">
      {%- elsif section.settings.mobile_image == blank -%}
        <div class="stl__ph">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
      {%- if section.settings.mobile_image != blank -%}
        {%- assign mimg = section.settings.mobile_image -%}
        <img class="stl__img stl__img--mob" src="{{ mimg | image_url: width: 900 }}" srcset="{{ mimg | image_url: width: 600 }} 600w, {{ mimg | image_url: width: 900 }} 900w" sizes="100vw" alt="{{ mimg.alt | default: section.settings.heading | escape }}" width="{{ mimg.width }}" height="{{ mimg.height }}" loading="lazy" decoding="async">
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- liquid
          assign p = block.settings.product
          assign x = block.settings.x
          assign y = block.settings.y
          assign xm = block.settings.x_mobile
          assign ym = block.settings.y_mobile
          assign hx = 'right'
          if x >= 50
            assign hx = 'left'
          endif
          assign hxm = 'right'
          if xm >= 50
            assign hxm = 'left'
          endif
          assign vy = 'down'
          if y >= 50
            assign vy = 'up'
          endif
          assign on_sale = false
          if p.compare_at_price > p.price and p.available
            assign on_sale = true
          endif
        -%}
        <div class="stl__spot js-stl-spot" style="--x: {{ x }}%; --y: {{ y }}%; --xm: {{ xm }}%; --ym: {{ ym }}%;" {{ block.shopify_attributes }}>
          <button type="button" class="stl__dot js-stl-dot" aria-label="{{ p.title | default: 'View product' | escape }}"></button>
          {%- if p != blank and section.settings.show_label -%}
            <span class="stl__label stl__label--{{ hx }} stl__label--m-{{ hxm }}"><span class="stl__label-text">{{ p.title }}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          {%- endif -%}
          {%- if p != blank -%}
            <div class="stl__card stl__card--{{ hx }} stl__card--{{ vy }}">
              <button type="button" class="stl__close js-stl-close" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
              <a class="stl__thumb" href="{{ p.url }}">{%- if p.featured_image != blank -%}<img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" width="150" height="200" loading="lazy">{%- endif -%}</a>
              <div class="stl__body">
                <a class="stl__name" href="{{ p.url }}">{{ p.title }}</a>
                <div class="stl__price{% if on_sale %} stl__price--sale{% endif %}">{{ p.price | money }}{%- if on_sale -%}<s>{{ p.compare_at_price | money }}</s>{%- endif -%}</div>
                {%- if p.available -%}
                  <button type="button" class="stl__buy js-stl-buy" data-variant="{{ p.selected_or_first_available_variant.id }}">{{ section.settings.button_label | default: 'Quick Buy' }}</button>
                {%- else -%}
                  <a class="stl__buy" href="{{ p.url }}" style="text-align:center;text-decoration:none;">Sold out</a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('stl-{{ section.id }}');
  if (!root) return;
  var spots = root.querySelectorAll('.js-stl-spot');
  var stage = root.querySelector('.js-stl-stage');
  function closeAll() { spots.forEach(function (s) { s.classList.remove('is-open'); }); }
  function positionCard(spot) {
    var card = spot.querySelector('.stl__card');
    if (!card || !stage) return;
    var gap = 14, pad = 6;
    var dotX = spot.offsetLeft, dotY = spot.offsetTop;
    var stageW = stage.clientWidth, stageH = stage.clientHeight;
    card.style.right = 'auto'; card.style.bottom = 'auto'; card.style.left = '0px'; card.style.top = '0px';
    var cardW = card.offsetWidth, cardH = card.offsetHeight;
    var left;
    if (dotX + gap + cardW <= stageW - pad) { left = gap; }
    else if (dotX - gap - cardW >= pad) { left = -gap - cardW; }
    else { var dx = Math.min(Math.max(dotX - cardW / 2, pad), stageW - cardW - pad); left = dx - dotX; }
    var dy = Math.min(Math.max(dotY - cardH / 2, pad), stageH - cardH - pad);
    card.style.left = Math.round(left) + 'px';
    card.style.top = Math.round(dy - dotY) + 'px';
  }
  spots.forEach(function (spot) {
    var dot = spot.querySelector('.js-stl-dot');
    dot.addEventListener('click', function (e) {
      e.stopPropagation();
      var open = spot.classList.contains('is-open');
      closeAll();
      if (!open) { spot.classList.add('is-open'); positionCard(spot); }
    });
  });
  document.addEventListener('click', function (e) { if (!e.target.closest('.stl__card')) closeAll(); });
  root.querySelectorAll('.js-stl-buy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var id = btn.getAttribute('data-variant');
      if (!id) return;
      btn.disabled = true; var t = btn.textContent; btn.textContent = 'Adding...';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: id, quantity: 1 }] }) })
        .then(function (r) { return r.json(); })
        .then(function () { window.location.href = '/cart'; })
        .catch(function () { btn.disabled = false; btn.textContent = t; alert('Could not add to cart.'); });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Shop the Look",
  "tag": "section",
  "class": "section-shop-the-look",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Look" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Lifestyle image (desktop)", "info": "Add hotspot blocks below and position them on this image." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)", "info": "Shown on phones. Falls back to the desktop image." },
    { "type": "header", "content": "Hotspots" },
    { "type": "paragraph", "content": "Add a hotspot per product, then drag-set its position with the X / Y sliders." },
    { "type": "checkbox", "id": "show_label", "label": "Show product title pill (hover / mobile)", "default": true },
    { "type": "text", "id": "button_label", "label": "Buy button label", "default": "Quick Buy" },
    { "type": "color", "id": "dot_color", "label": "Hotspot dot color", "default": "#ffffff" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Corner radius", "default": 18 },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max content width", "default": 1280 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Neon accent", "default": "#C6F135" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "header", "content": "Desktop position" },
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Horizontal", "default": 50 },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Vertical", "default": 50 },
        { "type": "header", "content": "Mobile position" },
        { "type": "range", "id": "x_mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Horizontal", "default": 50 },
        { "type": "range", "id": "y_mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Vertical", "default": 50 }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop the Look",
      "blocks": [ { "type": "hotspot" }, { "type": "hotspot", "settings": { "x": 30, "y": 70 } } ]
    }
  ]
}
{% endschema %}
