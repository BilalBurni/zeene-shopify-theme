{%- liquid
  assign s = section.settings
  assign cols = section.blocks.size | at_least: 1

  assign ar = s.accent_color | color_extract: 'red'
  assign ag = s.accent_color | color_extract: 'green'
  assign ab = s.accent_color | color_extract: 'blue'
  assign accent_bright = s.accent_color | color_brightness
  assign on_accent = '#0a0a0a'
  if accent_bright < 140
    assign on_accent = '#ffffff'
  endif
-%}
{%- capture tint -%}rgba({{ ar }}, {{ ag }}, {{ ab }}, 0.13){%- endcapture -%}
{%- capture tint_strong -%}rgba({{ ar }}, {{ ag }}, {{ ab }}, 0.28){%- endcapture -%}

{%- style -%}
#usp-strip-{{ section.id }} { background: {{ s.bg_color }}; padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px; {% if s.show_top_border %}border-top: 1px solid {{ s.border_color }};{% endif %} {% if s.show_bottom_border %}border-bottom: 1px solid {{ s.border_color }};{% endif %} }
#usp-strip-{{ section.id }} .usp__inner { max-width: {{ s.max_width }}px; margin: 0 auto; padding: 0 16px; display: grid; grid-template-columns: repeat({{ cols }}, minmax(0, 1fr)); gap: {{ s.gap }}px; }
#usp-strip-{{ section.id }} .usp__item { position: relative; display: flex; align-items: center; gap: {{ s.icon_gap }}px; min-width: 0; }
#usp-strip-{{ section.id }} .usp__text { min-width: 0; }
#usp-strip-{{ section.id }} .usp__title { display: block; margin: 0; font-family: 'Zen Maru Gothic', sans-serif; font-size: {{ s.title_size }}px; font-weight: 700; line-height: 1.25; letter-spacing: -0.005em; color: {{ s.text_color }}; }
#usp-strip-{{ section.id }} .usp__sub { display: block; margin: 3px 0 0; font-size: {{ s.sub_size }}px; font-weight: 400; line-height: 1.35; color: {{ s.text_color }}; opacity: 0.58; }

{%- comment -%} Icon badge — chaar shakleen, sab ek hi box size par taake grid na hile. {%- endcomment -%}
#usp-strip-{{ section.id }} .usp__icon { position: relative; flex-shrink: 0; width: {{ s.icon_size }}px; height: {{ s.icon_size }}px; display: flex; align-items: center; justify-content: center; color: {{ s.accent_color }}; transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.35s cubic-bezier(.16,1,.3,1); }
#usp-strip-{{ section.id }} .usp__icon svg { width: {{ s.icon_size | times: 0.52 | round }}px; height: {{ s.icon_size | times: 0.52 | round }}px; }
{%- case s.icon_style -%}
  {%- when 'soft' -%}
#usp-strip-{{ section.id }} .usp__icon { background: {{ tint }}; border-radius: {{ s.icon_radius }}px; }
  {%- when 'solid' -%}
#usp-strip-{{ section.id }} .usp__icon { background: {{ s.accent_color }}; color: {{ on_accent }}; border-radius: {{ s.icon_radius }}px; }
  {%- when 'outline' -%}
#usp-strip-{{ section.id }} .usp__icon { border: 1.5px solid {{ tint_strong }}; border-radius: {{ s.icon_radius }}px; }
  {%- else -%}
#usp-strip-{{ section.id }} .usp__icon { color: {{ s.icon_color }}; }
#usp-strip-{{ section.id }} .usp__icon svg { width: {{ s.icon_size | times: 0.72 | round }}px; height: {{ s.icon_size | times: 0.72 | round }}px; }
{%- endcase -%}

{%- if s.style == 'stacked' -%}
{%- comment -%} The divider is a pseudo-element shifted by half the gap so it sits between the columns, not on the next one. {%- endcomment -%}
#usp-strip-{{ section.id }} .usp__item { flex-direction: column; align-items: center; text-align: center; gap: {{ s.icon_gap }}px; padding: 4px {{ s.gap | divided_by: 2 | at_least: 8 }}px; }
#usp-strip-{{ section.id }} .usp__title { font-size: {{ s.title_size }}px; font-weight: 500; line-height: 1.3; }
#usp-strip-{{ section.id }} .usp__sub { margin-top: 7px; max-width: 280px; margin-left: auto; margin-right: auto; opacity: 0.62; }
{%- if s.dividers and section.blocks.size > 1 -%}
#usp-strip-{{ section.id }} .usp__item::before { content: ''; position: absolute; top: 0; bottom: 0; left: -{{ s.gap | divided_by: 2 }}px; width: 1px; background: {{ s.border_color }}; }
#usp-strip-{{ section.id }} .usp__item:first-child::before { display: none; }
{%- endif -%}
{%- elsif s.style == 'cards' -%}
#usp-strip-{{ section.id }} .usp__item { padding: {{ s.card_padding }}px {{ s.card_padding | plus: 2 }}px; background: {{ s.card_color }}; border: 1px solid {{ s.card_border }}; border-radius: {{ s.card_radius }}px; overflow: hidden; transition: transform 0.32s cubic-bezier(.16,1,.3,1), box-shadow 0.32s ease, border-color 0.32s ease; }
{%- if s.card_shadow -%}
#usp-strip-{{ section.id }} .usp__item { box-shadow: 0 6px 18px -14px rgba(20, 16, 40, 0.35); }
{%- endif -%}
#usp-strip-{{ section.id }} .usp__item::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: {{ s.accent_color }}; transform: scaleX(0); transform-origin: left; transition: transform 0.4s cubic-bezier(.16,1,.3,1); }
{%- if s.hover_lift -%}
#usp-strip-{{ section.id }} .usp__item:hover { transform: translateY(-3px); border-color: {{ tint_strong }}; box-shadow: 0 20px 36px -20px rgba(20, 16, 40, 0.34); }
#usp-strip-{{ section.id }} .usp__item:hover::after { transform: scaleX(1); }
#usp-strip-{{ section.id }} .usp__item:hover .usp__icon { transform: scale(1.06); }
{%- if s.icon_style == 'soft' or s.icon_style == 'outline' -%}
#usp-strip-{{ section.id }} .usp__item:hover .usp__icon { background: {{ s.accent_color }}; color: {{ on_accent }}; border-color: {{ s.accent_color }}; }
{%- endif -%}
{%- endif -%}
{%- else -%}
{%- if s.dividers and section.blocks.size > 1 -%}
#usp-strip-{{ section.id }} .usp__item { padding-right: {{ s.gap }}px; border-right: 1px solid {{ s.border_color }}; }
#usp-strip-{{ section.id }} .usp__item:last-child { border-right: none; padding-right: 0; }
{%- endif -%}
{%- endif -%}

@media (max-width: 989px) {
  #usp-strip-{{ section.id }} .usp__inner { grid-template-columns: repeat({% if cols > 2 %}2{% else %}{{ cols }}{% endif %}, minmax(0, 1fr)); gap: {{ s.gap | times: 0.6 | round | at_least: 10 }}px; }
  #usp-strip-{{ section.id }} .usp__item { border-right: none; padding-right: {% if s.style == 'cards' %}{{ s.card_padding | plus: 2 }}px{% else %}0{% endif %}; }
  #usp-strip-{{ section.id }} .usp__item::before { display: none; }
}
@media (max-width: 749px) {
  #usp-strip-{{ section.id }} { padding-top: {{ s.padding_top | times: 0.6 | round }}px; padding-bottom: {{ s.padding_bottom | times: 0.6 | round }}px; }
  #usp-strip-{{ section.id }} .usp__inner { padding: 0 14px; gap: 10px; }
  #usp-strip-{{ section.id }} .usp__item { gap: {{ s.icon_gap | times: 0.75 | round }}px; {% if s.style == 'cards' %}padding: {{ s.card_padding | times: 0.7 | round }}px; border-radius: {{ s.card_radius | times: 0.85 | round }}px;{% endif %} }
  #usp-strip-{{ section.id }} .usp__icon { width: {{ s.icon_size | times: 0.78 | round }}px; height: {{ s.icon_size | times: 0.78 | round }}px; }
  #usp-strip-{{ section.id }} .usp__icon svg { width: {{ s.icon_size | times: 0.42 | round }}px; height: {{ s.icon_size | times: 0.42 | round }}px; }
  #usp-strip-{{ section.id }} .usp__title { font-size: {{ s.title_size | minus: 1 }}px; }
  #usp-strip-{{ section.id }} .usp__sub { font-size: {{ s.sub_size | minus: 1 }}px; }

  {%- if s.style == 'stacked' -%}
  #usp-strip-{{ section.id }} .usp__inner { gap: 0; }
  #usp-strip-{{ section.id }} .usp__item { padding: {{ s.mobile_row_padding }}px 8px; gap: {{ s.icon_gap | times: 0.7 | round }}px; }
  #usp-strip-{{ section.id }} .usp__title { font-size: {{ s.title_size | times: 0.75 | round | at_least: 12 }}px; line-height: 1.3; }
  #usp-strip-{{ section.id }} .usp__sub { max-width: none; margin-top: 4px; font-size: {{ s.sub_size | times: 0.85 | round | at_least: 10 }}px; line-height: 1.4; }
  {%- if s.icon_style == 'plain' -%}
  #usp-strip-{{ section.id }} .usp__icon svg { width: {{ s.icon_size | times: 0.6 | round }}px; height: {{ s.icon_size | times: 0.6 | round }}px; }
  {%- endif -%}
  {%- if s.dividers and section.blocks.size > 1 -%}
  #usp-strip-{{ section.id }} .usp__item::before { display: block; left: 0; top: {{ s.mobile_row_padding | times: 0.5 | round }}px; bottom: {{ s.mobile_row_padding | times: 0.5 | round }}px; }
  #usp-strip-{{ section.id }} .usp__item:nth-child(odd)::before { display: none; }
  #usp-strip-{{ section.id }} .usp__item::after { content: ''; position: absolute; top: 0; left: 10px; right: 10px; height: 1px; background: {{ s.border_color }}; }
  #usp-strip-{{ section.id }} .usp__item:nth-child(-n+2)::after { display: none; }
  {%- endif -%}
  {%- endif -%}

  {%- if s.mobile_layout == 'slider' -%}
  #usp-strip-{{ section.id }} .usp__inner { display: flex; grid-template-columns: none; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding-bottom: 4px; }
  #usp-strip-{{ section.id }} .usp__inner::-webkit-scrollbar { display: none; }
  #usp-strip-{{ section.id }} .usp__item { flex: 0 0 {{ s.mobile_card_width }}%; scroll-snap-align: start; }
  #usp-strip-{{ section.id }} .usp__item::before, #usp-strip-{{ section.id }} .usp__item::after { display: none; }
  {%- endif -%}
}
@media (prefers-reduced-motion: reduce) {
  #usp-strip-{{ section.id }} .usp__item, #usp-strip-{{ section.id }} .usp__icon, #usp-strip-{{ section.id }} .usp__item::after { transition: none; }
  #usp-strip-{{ section.id }} .usp__item:hover { transform: none; }
  #usp-strip-{{ section.id }} .usp__item:hover .usp__icon { transform: none; }
}
{%- endstyle -%}

<div id="usp-strip-{{ section.id }}" class="usp">
  <div class="usp__inner">
    {%- for block in section.blocks -%}
      <div class="usp__item" {{ block.shopify_attributes }}>
        <span class="usp__icon">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h13v13H1zM14 8h4l3 3v5h-7M5.5 19a2 2 0 100-4 2 2 0 000 4zM17.5 19a2 2 0 100-4 2 2 0 000 4z"/></svg>
            {%- when 'cash' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="5" width="22" height="14" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M5 9v.01M19 15v.01"/></svg>
            {%- when 'return' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 109-9 9 9 0 00-7 3.3M3 4v3.3h3.3"/></svg>
            {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5z"/><path d="M9 12l2 2 4-4"/></svg>
            {%- when 'headset' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14v-2a8 8 0 0116 0v2M4 14h2v5H4a1 1 0 01-1-1v-3a1 1 0 011-1zM20 14h-2v5h2a1 1 0 001-1v-3a1 1 0 00-1-1zM18 19a4 4 0 01-4 3h-2"/></svg>
            {%- when 'gift' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 22V7M12 7H8a2.5 2.5 0 010-5c2.5 0 4 3 4 5zM12 7h4a2.5 2.5 0 000-5c-2.5 0-4 3-4 5z"/></svg>
            {%- when 'tag' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4l-7.2 7.2a2 2 0 01-2.8 0l-7-7A2 2 0 013 12.2V5a2 2 0 012-2h7.2a2 2 0 011.4.6l7 7a2 2 0 010 2.8z"/><path d="M7.5 7.5v.01"/></svg>
            {%- when 'star' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.9 6.3 6.6.6-5 4.4 1.5 6.7L12 17.5 6 21l1.5-6.7-5-4.4 6.6-.6z"/></svg>
            {%- when 'lock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
            {%- when 'clock' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
            {%- when 'chat' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 01-9 8.4 9 9 0 01-4-.9L3 21l1.9-4.9a8.4 8.4 0 01-.9-4A8.4 8.4 0 0112.5 3 8.4 8.4 0 0121 11.5z"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg>
          {%- endcase -%}
        </span>
        <span class="usp__text">
          {%- if block.settings.title != blank -%}<span class="usp__title">{{ block.settings.title }}</span>{%- endif -%}
          {%- if block.settings.subtitle != blank -%}<span class="usp__sub">{{ block.settings.subtitle }}</span>{%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "USP Strip",
  "tag": "section",
  "class": "section-usp-strip",
  "settings": [
    { "type": "header", "content": "Style" },
    {
      "type": "select", "id": "style", "label": "Layout style", "default": "stacked",
      "options": [
        { "value": "stacked", "label": "Centered — icon on top" },
        { "value": "cards", "label": "Cards" },
        { "value": "minimal", "label": "Minimal — icon beside text" }
      ]
    },
    {
      "type": "select", "id": "icon_style", "label": "Icon style", "default": "plain",
      "options": [
        { "value": "soft", "label": "Soft badge (tinted)" },
        { "value": "solid", "label": "Solid badge (accent)" },
        { "value": "outline", "label": "Outlined badge" },
        { "value": "plain", "label": "Plain icon (no badge)" }
      ]
    },
    { "type": "checkbox", "id": "hover_lift", "label": "Lift card on hover", "default": true },
    { "type": "checkbox", "id": "card_shadow", "label": "Soft shadow on cards", "default": true },
    { "type": "checkbox", "id": "dividers", "label": "Dividers between items", "default": true, "info": "Minimal style only." },

    { "type": "header", "content": "Sizes" },
    { "type": "range", "id": "icon_size", "min": 28, "max": 68, "step": 2, "unit": "px", "label": "Icon badge size", "default": 46 },
    { "type": "range", "id": "icon_radius", "min": 0, "max": 34, "step": 1, "unit": "px", "label": "Icon badge corner radius", "default": 13, "info": "Set to half the badge size for a circle." },
    { "type": "range", "id": "icon_gap", "min": 6, "max": 28, "step": 1, "unit": "px", "label": "Gap between icon and text", "default": 14 },
    { "type": "range", "id": "title_size", "min": 11, "max": 28, "step": 1, "unit": "px", "label": "Title size", "default": 19 },
    { "type": "range", "id": "sub_size", "min": 9, "max": 16, "step": 1, "unit": "px", "label": "Subtitle size", "default": 13 },
    { "type": "range", "id": "card_padding", "min": 8, "max": 32, "step": 1, "unit": "px", "label": "Card padding", "default": 18 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 28, "step": 1, "unit": "px", "label": "Card corner radius", "default": 14 },
    { "type": "range", "id": "gap", "min": 8, "max": 48, "step": 4, "unit": "px", "label": "Gap between items", "default": 16 },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max content width", "default": 1280 },

    { "type": "header", "content": "Mobile" },
    {
      "type": "select", "id": "mobile_layout", "label": "Mobile layout", "default": "grid",
      "options": [
        { "value": "grid", "label": "2 per row" },
        { "value": "slider", "label": "Swipe slider" }
      ]
    },
    { "type": "range", "id": "mobile_card_width", "min": 45, "max": 90, "step": 5, "unit": "%", "label": "Card width (slider)", "default": 65 },
    { "type": "range", "id": "mobile_row_padding", "min": 8, "max": 32, "step": 1, "unit": "px", "label": "Row padding (centered style)", "default": 18 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#fbfbfb" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#ececec" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Accent (icon badge)", "default": "#c6f135" },
    { "type": "color", "id": "icon_color", "label": "Icon color (plain style)", "default": "#0a0a0a" },
    { "type": "color", "id": "border_color", "label": "Section borders / dividers", "default": "#e6e6e6" },
    { "type": "checkbox", "id": "show_top_border", "label": "Top border", "default": true },
    { "type": "checkbox", "id": "show_bottom_border", "label": "Bottom border", "default": true },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding top", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Padding bottom", "default": 32 }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Benefit",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck (delivery)" },
            { "value": "cash", "label": "Cash (COD)" },
            { "value": "return", "label": "Return / refresh" },
            { "value": "shield", "label": "Shield (authentic)" },
            { "value": "headset", "label": "Support" },
            { "value": "chat", "label": "Chat / WhatsApp" },
            { "value": "gift", "label": "Gift" },
            { "value": "tag", "label": "Tag (deals)" },
            { "value": "star", "label": "Star (rated)" },
            { "value": "lock", "label": "Lock (secure)" },
            { "value": "clock", "label": "Clock (fast)" },
            { "value": "check", "label": "Check" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free Delivery" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "On all orders" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "USP Strip",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "title": "Free Delivery", "subtitle": "On all orders" } },
        { "type": "usp", "settings": { "icon": "cash", "title": "Cash on Delivery", "subtitle": "Pay at your door" } },
        { "type": "usp", "settings": { "icon": "return", "title": "Easy Returns", "subtitle": "7-day exchange" } },
        { "type": "usp", "settings": { "icon": "shield", "title": "100% Original", "subtitle": "Premium quality" } }
      ]
    }
  ]
}
{% endschema %}
