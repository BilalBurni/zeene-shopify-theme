{%- liquid
  assign cols = section.settings.columns_desktop
  assign radius = section.settings.corner_radius
  assign ratio = section.settings.ratio
-%}

{%- style -%}
#video-carousel-{{ section.id }} { background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; }
#video-carousel-{{ section.id }} .vc__inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; padding: 0 16px; }
#video-carousel-{{ section.id }} .vc__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 26px; }
#video-carousel-{{ section.id }} .vc__heading { margin: 0; font-family: 'Zen Maru Gothic', sans-serif; font-size: clamp(20px, 2.6vw, 26px); font-weight: 700; line-height: 1.3; }
#video-carousel-{{ section.id }} .vc__sub { margin: 8px 0 0; font-size: 14px; line-height: 1.5; opacity: 0.65; }
#video-carousel-{{ section.id }} .vc__nav { display: flex; gap: 8px; flex-shrink: 0; }
#video-carousel-{{ section.id }} .vc__arrow { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; border-radius: 9999px; border: 1px solid #e2e2e2; background: #fff; color: {{ section.settings.text_color }}; cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease; }
#video-carousel-{{ section.id }} .vc__arrow:hover { background: {{ section.settings.accent_color }}; border-color: {{ section.settings.accent_color }}; color: #0a0a0a; }
#video-carousel-{{ section.id }} .vc__arrow svg { width: 18px; height: 18px; }
#video-carousel-{{ section.id }} .vc__track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
#video-carousel-{{ section.id }} .vc__track::-webkit-scrollbar { display: none; }
#video-carousel-{{ section.id }} .vc__card { position: relative; flex: 0 0 calc(100% / {{ cols }} - 14px); scroll-snap-align: start; }
#video-carousel-{{ section.id }} .vc__media { position: relative; border-radius: {{ radius }}px; overflow: hidden; aspect-ratio: {{ ratio }}; background: #f0f0f0; isolation: isolate; }
#video-carousel-{{ section.id }} .vc__media video, #video-carousel-{{ section.id }} .vc__media img, #video-carousel-{{ section.id }} .vc__media iframe { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; display: block; }
#video-carousel-{{ section.id }} .vc__facade { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; cursor: pointer; background: #f0f0f0; }
#video-carousel-{{ section.id }} .vc__play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; border-radius: 9999px; background: {{ section.settings.accent_color }}; color: #0a0a0a; box-shadow: 0 8px 24px rgba(0,0,0,0.3); transition: transform 0.25s ease; pointer-events: none; }
#video-carousel-{{ section.id }} .vc__facade:hover .vc__play { transform: translate(-50%, -50%) scale(1.08); }
#video-carousel-{{ section.id }} .vc__play svg { width: 24px; height: 24px; margin-left: 3px; }
#video-carousel-{{ section.id }} .vc__overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, rgba(8,8,8,0.6) 0%, rgba(8,8,8,0) 45%); pointer-events: none; }
#video-carousel-{{ section.id }} .vc__caption { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 16px; color: #fff; font-size: 16px; font-weight: 700; line-height: 1.2; pointer-events: none; }
#video-carousel-{{ section.id }} .vc__link { position: absolute; inset: 0; z-index: 3; }
#video-carousel-{{ section.id }} .vc__ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: #f4f4f4; }
#video-carousel-{{ section.id }} .vc__ph svg { width: 30%; height: 30%; opacity: 0.4; fill: #b8b8b8; }
@media (max-width: 989px) { #video-carousel-{{ section.id }} .vc__nav { display: none; } #video-carousel-{{ section.id }} .vc__card { flex: 0 0 46%; } }
@media (max-width: 749px) { #video-carousel-{{ section.id }} .vc__head { margin-bottom: 16px; } #video-carousel-{{ section.id }} .vc__heading { font-size: 24px; } #video-carousel-{{ section.id }} .vc__card { flex: 0 0 {{ section.settings.mobile_card_width }}%; } }
{%- endstyle -%}

<div id="video-carousel-{{ section.id }}" class="vc">
  <div class="vc__inner">
    <div class="vc__head">
      <div>
        {%- if section.settings.heading != blank -%}<h2 class="vc__heading">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="vc__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      {%- if section.blocks.size > cols -%}
        <div class="vc__nav">
          <button type="button" class="vc__arrow js-vc-prev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
          <button type="button" class="vc__arrow js-vc-next" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      {%- endif -%}
    </div>

    <div class="vc__track js-vc-track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign vid = block.settings.video
          assign ext = block.settings.video_url
          assign poster = block.settings.poster | default: vid.preview_image
        -%}
        <div class="vc__card" {{ block.shopify_attributes }}>
          <div class="vc__media">
            {%- if vid != blank -%}
              <video class="js-vc-video" muted loop playsinline preload="none"{% if poster != blank %} poster="{{ poster | image_url: width: 800 }}"{% endif %}>
                {%- for source in vid.sources -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endfor -%}
              </video>
            {%- elsif ext != blank -%}
              <button type="button" class="vc__facade js-vc-facade" data-type="{{ ext.type }}" data-id="{{ ext.id }}" aria-label="Play video">
                {%- if poster != blank -%}<img src="{{ poster | image_url: width: 800 }}" alt="{{ block.settings.heading | escape }}" width="800" height="1000" loading="lazy" decoding="async">{%- else -%}<img src="{% render 'demo-image', set: 'lifestyle', index: forloop.index0, width: 800 %}" alt="{{ block.settings.heading | escape }}" width="800" height="1000" loading="lazy" decoding="async">{%- endif -%}
                <span class="vc__play"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
              </button>
            {%- elsif poster != blank -%}
              <img src="{{ poster | image_url: width: 800 }}" alt="{{ block.settings.heading | escape }}" width="800" height="1000" loading="lazy" decoding="async">
            {%- else -%}
              <span class="vc__ph">{{ 'image' | placeholder_svg_tag }}</span>
            {%- endif -%}
            <span class="vc__overlay"></span>
            {%- if block.settings.heading != blank -%}<span class="vc__caption">{{ block.settings.heading }}</span>{%- endif -%}
            {%- if block.settings.link != blank and vid != blank -%}<a class="vc__link" href="{{ block.settings.link }}" aria-label="{{ block.settings.heading | default: 'View' | escape }}"></a>{%- endif -%}
          </div>
        </div>
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="vc__card"><div class="vc__media"><img src="{% render 'demo-image', set: 'lifestyle', index: i, width: 800 %}" alt="" width="800" height="1000" loading="lazy" decoding="async"><span class="vc__overlay"></span><span class="vc__play"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span></div></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('video-carousel-{{ section.id }}');
  if (!root) return;
  var track = root.querySelector('.js-vc-track');
  var prev = root.querySelector('.js-vc-prev');
  var next = root.querySelector('.js-vc-next');
  function step() { var card = track.querySelector('.vc__card'); return card ? card.offsetWidth + 16 : 300; }
  if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var videos = root.querySelectorAll('.js-vc-video');
  if (videos.length && !reduce && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        var v = e.target;
        if (e.isIntersecting && e.intersectionRatio >= 0.5) { if (!document.hidden) v.play().catch(function () {}); }
        else { v.pause(); }
      });
    }, { threshold: [0, 0.5, 1] });
    videos.forEach(function (v) { io.observe(v); });
    document.addEventListener('visibilitychange', function () { if (document.hidden) videos.forEach(function (v) { v.pause(); }); });
  }

  root.querySelectorAll('.js-vc-facade').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var type = btn.getAttribute('data-type');
      var id = btn.getAttribute('data-id');
      var src = type === 'vimeo' ? 'https://player.vimeo.com/video/' + id + '?autoplay=1&title=0&byline=0' : 'https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0';
      var iframe = document.createElement('iframe');
      iframe.setAttribute('src', src);
      iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('title', 'Video');
      btn.parentNode.insertBefore(iframe, btn);
      btn.remove();
    });
  });
})();
</script>

{% schema %}
{
  "name": "Video Carousel",
  "tag": "section",
  "class": "section-video-carousel",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Watch & Shop" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Desktop columns", "default": 4 },
    { "type": "select", "id": "ratio", "label": "Card aspect ratio", "options": [ { "value": "9/16", "label": "Reel (9:16)" }, { "value": "3/4", "label": "Portrait (3:4)" }, { "value": "1/1", "label": "Square (1:1)" }, { "value": "16/9", "label": "Wide (16:9)" } ], "default": "9/16" },
    { "type": "range", "id": "corner_radius", "min": 0, "max": 28, "step": 2, "unit": "px", "label": "Corner radius", "default": 16 },
    { "type": "range", "id": "mobile_card_width", "min": 55, "max": 90, "step": 5, "unit": "%", "label": "Mobile card width", "default": 70 },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max content width", "default": 1280 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0a0a0a" },
    { "type": "color", "id": "accent_color", "label": "Neon accent", "default": "#C6F135" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (upload)", "info": "Uploaded videos autoplay muted in view." },
        { "type": "video_url", "id": "video_url", "label": "Or video link (YouTube/Vimeo)", "accept": ["youtube", "vimeo"], "info": "Used if no uploaded video. Click to play." },
        { "type": "image_picker", "id": "poster", "label": "Poster / thumbnail" },
        { "type": "text", "id": "heading", "label": "Caption" },
        { "type": "url", "id": "link", "label": "Link (uploaded video only)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Video Carousel",
      "blocks": [ { "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" } ]
    }
  ]
}
{% endschema %}
