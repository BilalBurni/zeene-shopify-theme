    { "type": "checkbox", "id": "sticky_bar", "label": "Sticky buy bar on scroll", "default": true, "info": "Scroll karne par upar ek chhota add-to-cart bar aata hai." },
    { "type": "checkbox", "id": "video_show", "label": "Floating product video", "default": true, "info": "Product ke media mein video (upload ya YouTube/Vimeo) ho to neeche-baayein chhota floating video aata hai — click par lightbox." },
    { "type": "header", "content": "Delivery estimate" },
