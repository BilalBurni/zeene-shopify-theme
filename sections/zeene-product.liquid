    { "type": "range", "id": "del_processing_days", "min": 1, "max": 5, "step": 1, "unit": "d", "label": "Processing after (days)", "default": 1 },
    { "type": "range", "id": "del_delivery_days", "min": 2, "max": 10, "step": 1, "unit": "d", "label": "Delivered after (days)", "default": 3 },
