    { "type": "product_list", "id": "fbt_products", "label": "Products", "limit": 6, "info": "Sab products par yahi list dikhegi." },
    { "type": "text", "id": "fbt_button", "label": "Button text", "default": "Add bundle to cart" },
    { "type": "text", "id": "fbt_note", "label": "Note under total", "default": "Selected items will be added to cart." },
    { "type": "header", "content": "Disclaimer & info drawer" },
    { "type": "paragraph", "content": "Ye content SAB products par same rehta hai (ek dafa yahan set karein). Jis tab ka content khali ho wo link/tab nahi dikhta." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer text", "default": "Disclaimer: Actual product color and texture may slightly vary from the image." },
    { "type": "text", "id": "info_title", "label": "Drawer title", "default": "Product Information" },
    { "type": "text", "id": "info1_label", "label": "Tab 1 label", "default": "Deliveries & Exchange" },
    { "type": "html", "id": "info1_content", "label": "Tab 1 content (HTML)", "info": "Headings ke liye <h4>, bold ke liye <strong>, bullets ke liye <ul><li>.", "default": "<h4>Delivery Terms &amp; Conditions</h4><ul><li>Enjoy <strong>FREE DELIVERY</strong> on paid orders.</li><li>Cash on Delivery (COD) available nationwide.</li><li>Orders are typically delivered within 2–5 working days. During grand sales, delivery may take longer.</li></ul><h4>Exchange Eligibility</h4><ul><li>Items can be exchanged within 7 days of delivery.</li><li>The item must be unused, unwashed, and returned with all tags intact.</li><li>Faulty or incorrect items are eligible for a free exchange.</li></ul>" },
    { "type": "text", "id": "info2_label", "label": "Tab 2 label", "default": "Product Care" },
    { "type": "html", "id": "info2_content", "label": "Tab 2 content (HTML)", "default": "<p>To keep your garment in the best condition, follow these care instructions:</p><p><strong>Washing</strong>: Machine wash cold with like colors on a gentle cycle with mild detergent.</p><p><strong>Bleaching</strong>: Do not bleach. Avoid harsh chemicals that may damage the fabric.</p><p><strong>Drying</strong>: Tumble dry low or hang to dry. Avoid high heat to prevent shrinkage.</p><p><strong>Ironing</strong>: Iron on low heat if needed. Avoid direct contact with prints or embellishments.</p><p><strong>Storage</strong>: Store in a cool, dry place away from direct sunlight.</p>" },
    { "type": "richtext", "id": "shipping_info", "label": "Shipping & Returns text (accordion)" },
    { "type": "header", "content": "Layout & colors" },
    { "type": "range", "id": "max_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Max content width", "default": 1280 },
    { "type": "color", "id": "accent_color", "label": "Neon accent", "default": "#C6F135" }
  ]
}
{% endschema %}
