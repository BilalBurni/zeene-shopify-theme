    { "type": "range", "id": "vm_2_pct", "min": 0, "max": 60, "step": 1, "unit": "%", "label": "Buy 2 — discount", "default": 4 },
    { "type": "range", "id": "vm_3_pct", "min": 0, "max": 60, "step": 1, "unit": "%", "label": "Buy 3 — discount", "default": 7 },
    { "type": "range", "id": "vm_4_pct", "min": 0, "max": 60, "step": 1, "unit": "%", "label": "Buy 4 — discount", "default": 10 },
    { "type": "range", "id": "vm_5_pct", "min": 0, "max": 60, "step": 1, "unit": "%", "label": "Buy 5 — discount", "default": 12 },
