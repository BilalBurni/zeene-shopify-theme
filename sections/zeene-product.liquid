    { "type": "text", "id": "prepaid_label", "label": "Label", "default": "Pay online &amp; save" },
    { "type": "text", "id": "prepaid_note", "label": "Reveal note", "default": "Choose online payment (card / wallet) at checkout to unlock this discount." },
    { "type": "header", "content": "Promo & urgency" },
