    { "type": "text", "id": "del_before", "label": "Text before timer", "default": "Order today within" },
    { "type": "text", "id": "del_dispatch", "label": "Text after timer", "default": "for dispatch today." },
    { "type": "text", "id": "del_receive", "label": "Receive text", "default": "You'll receive your package between" },
    { "type": "text", "id": "del_s1", "label": "Stage 1 label", "default": "Purchased" },
    { "type": "text", "id": "del_s2", "label": "Stage 2 label", "default": "Processing" },
