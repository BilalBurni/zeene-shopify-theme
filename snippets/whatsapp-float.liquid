{%- comment -%} Rendered once in theme.liquid. Settings: Theme settings > WhatsApp. Number without '+', with country code. {%- endcomment -%}
{%- if settings.wa_show and settings.wa_number != blank -%}
  {%- liquid
# wa.me accepts digits only.
    assign wa_num = settings.wa_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  -%}
  <a
    class="wa-float"
    href="https://wa.me/{{ wa_num }}{% if settings.wa_message != blank %}?text={{ settings.wa_message | url_encode }}{% endif %}"
    target="_blank"
    rel="noopener"
    aria-label="{{ settings.wa_label | default: 'Chat on WhatsApp' | escape }}"
  >
    <svg class="wa-float__ic" viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"/><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.15h-.01c-1.52 0-3.02-.41-4.32-1.18l-.31-.18-3.21.84.86-3.13-.2-.32a8.18 8.18 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24z"/></svg>
  </a>

  {%- style -%}
  .wa-float { position: fixed; right: 18px; bottom: 18px; z-index: 6; display: inline-flex; align-items: center; justify-content: center; width: 54px; height: 54px; border-radius: 50%; background: #25D366; color: #fff; box-shadow: 0 10px 26px -8px rgba(37,211,102,0.6), 0 2px 8px rgba(0,0,0,0.18); transition: transform 0.25s cubic-bezier(.16,1,.3,1), box-shadow 0.25s ease; }
  .wa-float:hover { transform: scale(1.08); box-shadow: 0 14px 32px -8px rgba(37,211,102,0.75), 0 2px 10px rgba(0,0,0,0.22); }
  .wa-float__ic { display: block; }
  @media (max-width: 749px) { .wa-float { right: 12px; bottom: 12px; width: 48px; height: 48px; } .wa-float__ic { width: 25px; height: 25px; } }
  @media (prefers-reduced-motion: reduce) { .wa-float { transition: none; } }
  {%- endstyle -%}
{%- endif -%}
