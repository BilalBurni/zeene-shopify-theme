#zeene-product-{{ id }} .zp__sc-img { width: 100%; height: auto; display: block; border-radius: 10px; }
@media (max-width: 989px) {
  #zeene-product-{{ id }} .zp__inner { grid-template-columns: 1fr; gap: 24px; }
  #zeene-product-{{ id }} .zp__grid { display: flex; gap: 6px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  #zeene-product-{{ id }} .zp__grid::-webkit-scrollbar { display: none; }
  #zeene-product-{{ id }} .zp__cell { flex: 0 0 88%; scroll-snap-align: center; aspect-ratio: 3/4; }
  #zeene-product-{{ id }} .zp__cell--wide { grid-column: auto; aspect-ratio: 3/4; }
}
@media (max-width: 749px) {
  #zeene-product-{{ id }} { padding-bottom: 36px; }
  #zeene-product-{{ id }} .zp__inner { gap: 20px; }
  #zeene-product-{{ id }} .zp__qtyrow { flex-wrap: wrap; }
  #zeene-product-{{ id }} .zp__add { flex: 1 1 160px; }
  #zeene-product-{{ id }} .zp__info-links { gap: 12px 20px; }
  #zeene-product-{{ id }} .zp__info-link { font-size: 11px; }
}
{%- endstyle -%}
