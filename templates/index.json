    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "faq_item",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Orders are dispatched within 24 hours and usually delivered in <strong>3–5 working days</strong> across Pakistan — Karachi, Lahore, Islamabad, Rawalpindi, Faisalabad, Multan, Peshawar and beyond.</p>"
          }
        },
        "q2": {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer cash on delivery?",
            "answer": "<p>Yes. Cash on delivery is available on all orders across Pakistan — you pay when your order reaches you. You can also pay online and save extra on your order.</p>"
          }
        },
        "q3": {
          "type": "faq_item",
          "settings": {
            "question": "Is delivery free?",
            "answer": "<p>Yes — delivery is free on all orders, with no minimum order value.</p>"
          }
        },
        "q4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I exchange or return my order?",
            "answer": "<p>Yes. If the size or the piece isn't right, you can request an exchange or return within <strong>7 days</strong> of delivery, as long as the item is unused and in its original packaging with tags attached.</p>"
          }
        },
        "q5": {
          "type": "faq_item",
          "settings": {
            "question": "How do I choose the right size?",
            "answer": "<p>Every product page has a size chart under the product details — measure a piece you already own and match it to the chart. Our hoodies and tees are relaxed fit, so if you're between sizes we recommend going with your usual size.</p>"
          }
        },
        "q6": {
          "type": "faq_item",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>Once your order is dispatched, you'll receive a tracking number by SMS and email. You can also message us on WhatsApp and we'll share the latest update.</p>"
          }
        }
      },
